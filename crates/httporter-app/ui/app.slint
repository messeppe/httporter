// HTTPorter main window: toolbar, sidebar, main area and status bar (see docs/design/mockups/Main.dc.html).

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { FileKind, FileRow, PaneBounds, ProviderTile, S3Errors, SiteDraft, SiteItem, ZoneChoice } from "types.slint";
import { Toolbar } from "components/toolbar.slint";
import { Sidebar } from "components/sidebar.slint";
import { StatusBar } from "components/statusbar.slint";
import { Pane } from "components/pane.slint";
import { AddSiteSheet } from "components/add_site.slint";
import { WelcomeView } from "components/welcome.slint";
import { TransferRow } from "types.slint";
import { TransferDrawer } from "components/drawer.slint";
import { ConflictContents, ConflictRow } from "types.slint";
import { Banner, ConflictSheet, DeleteAlert, ImportSheet, NewFolderSheet, QuitAlert, RemoveSiteAlert } from "components/sheets.slint";
import { CapsuleButton } from "components/buttons.slint";
import { SettingsWindow } from "components/settings_window.slint";

export { FileKind, FileRow, PaneBounds, ProviderTile, S3Errors, SiteDraft, SiteItem, Theme, ZoneChoice }
export { TransferRow }
export { ConflictContents, ConflictRow }
export { SettingsWindow }

// Error message shown above the panes. When the open site's error is one editing the site fixes
// (no password saved, a sign-in that failed), it offers Edit Site… and Remove Site….
component ErrorBanner inherits Rectangle {
    in property <string> text;
    in property <bool> offer-edit: false;
    callback edit();
    callback remove();

    background: Theme.red-soft;
    border-radius: Theme.radius-sm;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        Image {
            source: Icons.warn;
            colorize: Theme.red;
            width: 16px;
            height: 16px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.red;
            font-size: Theme.font-body;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if root.offer-edit: CapsuleButton {
            text: @tr("Edit Site…");
            clicked => { root.edit(); }
        }
        if root.offer-edit: CapsuleButton {
            text: @tr("Remove Site…");
            clicked => { root.remove(); }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("HTTPorter");
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;
    background: Theme.win;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;

    in property <[SiteItem]> sites;
    in-out property <int> selected-site: -1;
    in property <string> connection-text;
    in property <bool> connection-ok;
    in property <string> endpoint-text;
    // The left of the status bar: the item count of the pane last used or focused (the same rule
    // as Back and Forward, see `local-pane-active`), unless a message has been put there since
    // (what a drop did). The message stays until that pane is listed again or the other pane is
    // used.
    in property <string> local-status;
    in property <string> remote-status;
    in-out property <string> status-message;
    // Which pane the message is about (0 This PC, 1 the cloud pane; -1 for neither): a drop on a
    // pane says so here, and only a listing of that pane (or turning to the other one) takes the
    // message away. A message about neither goes with a listing of either.
    in-out property <int> status-message-pane: -1;
    // What is selected in a pane ("index.html selected · 383.4 KB"), empty for nothing. It takes
    // the place of the item count while the pane is the one shown.
    in property <string> local-selection-text;
    in property <string> remote-selection-text;
    // How many rows are selected in each pane (what a drag of the selection carries).
    in property <int> local-selected-count: 0;
    in property <int> remote-selected-count: 0;
    out property <string> status-left: root.status-message != "" ? root.status-message : (root.local-pane-active ? (root.local-selection-text != "" ? root.local-selection-text : root.local-status) : (root.remote-selection-text != "" ? root.remote-selection-text : root.remote-status));
    in property <string> status-right;
    in property <string> error-text;
    // The open site's error is one Edit Site fixes: the banner offers Edit Site… and Remove Site….
    in property <bool> remote-offer-edit: false;
    in property <[FileRow]> local-rows;
    in property <[FileRow]> remote-rows;
    in property <[string]> local-crumbs;
    in property <[string]> remote-crumbs;
    // Storage endpoint shown as a chip in the cloud pane's header.
    in property <string> remote-chip;
    // Explorer files are being dragged over the cloud pane: it shows the accent ring and a "Release
    // to upload" chip, if a site is selected (with none there is nothing to upload to). Set from
    // the OS drag events (see src/drop_hook.rs), since Slint's DropArea does not see files dragged
    // in from other apps.
    in property <bool> drop-hover-remote: false;
    // The row of the cloud pane those files are over, when it is a folder (-1 for none): the row
    // is outlined and the chip names it. Set from the OS drag events like `drop-hover-remote`.
    in property <int> drop-hover-row: -1;
    // A listing for the pane is on its way: the pane says "Loading…" until it is in.
    in property <bool> local-loading: false;
    in property <bool> remote-loading: false;
    // The row the keyboard is on in each pane (-1 for none; which rows are selected is in each
    // row's `selected`) and the pane's sorted column (0 name, 1 size, 2 modified).
    in-out property <int> local-selected: -1;
    in-out property <int> remote-selected: -1;
    in-out property <int> local-sort-column: 0;
    in-out property <bool> local-sort-ascending: true;
    in-out property <int> remote-sort-column: 0;
    in-out property <bool> remote-sort-ascending: true;

    // The Add Site sheet. The window opens it when the sidebar's Add Site button is pressed (and
    // still tells the app through `add-site`); the app opens it too, and closes it once the site
    // is saved. `region-names` is the list the sheet offers, in the order the app maps to codes.
    in-out property <bool> add-site-open: false;
    in property <[string]> region-names;
    // `https://{host}/{zone}/` for the zone and region last reported by `add-site-changed`.
    in property <string> add-site-endpoint;
    // The outcome of the last test and whether it worked. The sheet clears the text when the zone,
    // region or password is edited, and when it opens.
    in-out property <string> add-site-result;
    in property <bool> add-site-result-ok;
    // A test or save is running: the sheet turns those two buttons off.
    in property <bool> add-site-busy;
    // Messages from the form's validation, shown under the field they name (see `add_site.rs`).
    // The sheet clears one when its field is edited, and all of them when it opens.
    in-out property <string> add-site-zone-error;
    in-out property <string> add-site-region-error;
    in-out property <string> add-site-password-error;
    // Bumped by `show_field_error` each time it shows an error; the sheet then focuses that field.
    in property <int> add-site-error-serial;

    // ---- Add Site, round 2: the S3 services, the Bunny account key, editing, Welcome ----
    // Ruling Q10: the S3 tiles, the "Bunny account key" sign-in, Import, the site menu and what
    // only they reach are turned off, with the note "Arrives later in this build.", until the app
    // has wired them and sets this.
    in property <bool> sites-v2-ready: false;
    // The sheet changes a saved site: Edit Site and Save, and an empty secret is kept. `draft` is
    // what its fields start with (the provider tile too); it is read when the sheet opens.
    in property <bool> add-site-editing: false;
    in property <SiteDraft> add-site-draft;
    // Import found the secret, which the app holds: an empty secret field uses it.
    in property <bool> add-site-secret-imported: false;
    // The message under the account key, and under the S3 fields.
    in-out property <string> add-site-key-error;
    in-out property <S3Errors> add-site-s3-errors;
    // The account's zones after Find Zones, which are ticked (one entry per zone, in the same
    // order) and how many. The sheet keeps the last two up to date when a box is pressed; the
    // app fills all three (`add_site::show_zones`) and empties them when it opens the sheet.
    in property <[ZoneChoice]> add-site-zones;
    in-out property <[bool]> add-site-zone-checked;
    in-out property <int> add-site-zone-count;
    // The buckets Choose… lists, whether they are being fetched and why they could not be.
    in property <[string]> add-site-buckets;
    in property <bool> add-site-buckets-busy;
    in property <string> add-site-buckets-error;

    // Back and Forward in the toolbar (and Alt+Left / Alt+Right) move through the folders of the
    // pane last used or focused, Finder-style: the This PC pane when `local-pane-active`, else the
    // cloud pane (the one they act on at first). The app says where each pane can go. Refresh and
    // the status bar's item count follow the same pane.
    in-out property <bool> local-pane-active: false;
    in property <bool> local-can-go-back;
    in property <bool> local-can-go-forward;
    in property <bool> remote-can-go-back;
    in property <bool> remote-can-go-forward;
    callback go-back();
    callback go-forward();
    // F5 or Ctrl+R: list the folder of the pane last used or focused again (as Back and Forward).
    callback refresh();

    // File actions. The toolbar buttons, the context menus and the keys (Ctrl+U, Ctrl+Shift+N,
    // Del) call them, only while the matching `can-*` is true; the app sets those from what is
    // selected and where. `delete-note` is why Delete is off when that is down to the pane in use;
    // `actions-note` is why the actions are off for now.
    in property <bool> can-upload: false;
    in property <bool> can-download: false;
    in property <bool> can-new-folder: false;
    in property <bool> can-delete: false;
    in property <string> delete-note;
    in property <string> actions-note;
    callback upload();
    callback download();
    callback download-to();
    callback new-folder();
    callback delete();
    // A row of a pane was pressed (pane 0 is This PC, 1 the cloud pane; row index into its
    // rows; whether Ctrl and Shift were held) or the keyboard landed on it. The app updates the
    // rows' `selected`.
    callback row-pointer(int /* pane */, int /* row */, bool /* ctrl */, bool /* shift */);
    // The rubber band covers rows `from` to `to` (both -1 for none); `additive` when Ctrl was held.
    callback band-select(int /* pane */, int /* from */, int /* to */, bool /* additive */);
    callback select-all(int /* pane */);
    // The This PC menu's Show in Explorer, for a row of that pane.
    callback show-in-explorer(int /* row */);
    // Dragging between the panes. The selection of This PC was dropped on the cloud pane (on its
    // folder row `row`, or -1 for the folder it shows), or the cloud selection on This PC (the same
    // for its rows). Called only while the matching `can-upload` / `can-download` is true. Dropping
    // on the pane the drag began in does nothing, and neither does Esc.
    callback drag-to-remote(int /* row */);
    callback drag-to-local(int /* row */);
    // Ctrl+V in the cloud pane (while `can-upload`): upload the files on the clipboard into the
    // folder it shows.
    callback paste();
    // The pane last used or focused changed (`local-pane-active`), which the toolbar follows.
    callback active-pane-changed();

    callback site-selected(int);
    callback add-site();
    // The site menu of a sidebar row: Edit… (the Add Site sheet as Edit Site), Duplicate and
    // Remove… (the Remove Site alert first).
    callback site-edit(int);
    callback site-duplicate(int);
    callback site-remove(int);
    // The sidebar's gear opens the Settings window; it is turned off (and says why) until the app
    // sets this.
    in property <bool> settings-available: false;
    callback open-settings();
    // Row index into the pane's `rows`, as the user sees them.
    callback open-local(int);
    callback open-remote(int);
    callback local-up();
    callback remote-up();
    // Column number: 0 name, 1 size, 2 modified. The pane has already updated its sort properties.
    callback sort-local(int);
    callback sort-remote(int);
    // A breadcrumb other than the last was pressed: the index into the pane's crumbs, where 0 is the
    // drive (This PC pane) or the zone (cloud pane).
    callback local-crumb-clicked(int);
    callback remote-crumb-clicked(int);
    // The zone or region on the sheet changed (also called once when it opens): the app answers
    // with `add-site-endpoint`.
    callback add-site-changed(string /* zone */, int /* region index */);
    // Test Connection and Add Site: site name, zone, region index, password. The name may be
    // empty (it then defaults to the zone). The app validates, and answers with field errors, a
    // test result, or by closing the sheet.
    callback add-site-test(string, string, int, string);
    callback add-site-save(string, string, int, string);
    // The sheet was cancelled (Cancel button or Escape); it has already closed itself. If a test or
    // save was running (`add-site-busy`), the app should give up on it and clear the flag.
    callback add-site-cancel();
    // The S3 fields changed (also called once when the sheet opens on an S3 form): the app answers
    // with `add-site-endpoint`.
    callback add-site-s3-changed(SiteDraft);
    // Test Connection and Add Site for an S3 service: the visible fields and the secret access key.
    callback add-site-test-s3(SiteDraft, string);
    callback add-site-save-s3(SiteDraft, string);
    // Another provider tile was chosen (0 Bunny Storage, 1 Amazon S3, 2 Cloudflare R2, 3 Backblaze
    // B2, 4 Wasabi, 5 DigitalOcean Spaces, 6 MinIO, 7 Other S3) and another way to sign in to
    // Bunny (0 storage zone password, 1 account key).
    callback add-site-provider(int);
    callback add-site-sign-in-mode(int);
    // Find Zones, with the account key; then Add n Sites, with which zones are ticked and whether
    // the key is kept (the second radio button).
    callback add-site-find-zones(string);
    callback add-site-zones-chosen([bool], bool);
    // Choose… beside the bucket: list what these fields and this secret access key can see.
    callback add-site-list-buckets(SiteDraft, string);
    // An eye button on the sheet was pressed.
    callback add-site-reveal();
    // The Welcome screen: Add Your First Site (the sheet has been opened and `add-site` called
    // already) and Import from .env or AWS profile…
    callback welcome-add();
    callback welcome-import();

    // The Import sheet the app opens for `welcome-import`: the AWS CLI profiles found ("default ·
    // eu-west-1"), and why the last .env file could not be used. The sheet closes itself before
    // it says what was chosen.
    in-out property <bool> import-open: false;
    in property <[string]> import-profiles;
    in-out property <string> import-error;
    callback import-profile(int);
    callback import-env();
    callback import-cancel();

    // ---- The transfer drawer (see components/drawer.slint) ----
    // The drawer is expanded, and which tab it shows (0 Active, 1 Queued, 2 Failed, 3 Done). The
    // Show / Hide Transfers button flips `transfers-open` itself and tells the app through
    // `transfers-toggle`.
    in-out property <bool> transfers-open: false;
    in-out property <int> transfers-tab: 0;
    // The engine has work (running, paused or stopped); `transfers-paused` is the user's pause.
    in property <bool> transfers-running;
    in property <bool> transfers-paused;
    // The one line of the collapsed drawer.
    in property <string> transfers-collapsed-text;
    in property <string> transfers-title;
    in property <string> transfers-line;
    // The speeds without their units, and the time left (empty when not known).
    in property <string> transfers-files-per-s;
    in property <string> transfers-mb-per-s;
    in property <string> transfers-eta;
    // Overall progress, 0 to 100.
    in property <float> transfers-percent;
    in property <[string]> transfers-tab-titles;
    in property <[TransferRow]> transfers-active;
    in property <[TransferRow]> transfers-queued;
    in property <[TransferRow]> transfers-failed;
    in property <[TransferRow]> transfers-done;
    callback transfers-toggle();
    callback transfers-pause();
    callback transfers-resume();
    callback transfers-cancel-all();
    // The row buttons give the job's id (`TransferRow.id`).
    callback transfer-cancel(int);
    callback transfer-retry(int);
    callback transfers-retry-failed();
    callback transfer-move-to-top(int);
    callback transfer-pause(int);
    callback transfer-resume(int);

    // ---- Sheets, alerts and banners (see components/sheets.slint and src/sheets_view.rs) ----
    // Each one opens when the app sets its `-open` flag (after filling in its texts), and closes
    // itself when the user answers, before the callback below is called. The transfer engine opens
    // them (Remove Site: the sidebar's site menu).

    // The conflict sheet. The texts come from `ConflictSheetView`; the rows' `action` is each
    // row's choice (0 Replace, 1 Skip, 2 Keep both) and is read back when Continue is pressed.
    in-out property <bool> conflicts-open: false;
    in property <string> conflicts-title;
    in property <string> conflicts-body;
    in property <string> conflicts-for-all;
    in property <string> conflicts-summary;
    in property <string> conflicts-col-source;
    in property <string> conflicts-col-target;
    in property <string> conflicts-remember;
    in property <string> conflicts-cancel-label;
    in-out property <[ConflictRow]> conflicts-rows;
    // The default action was changed (0 Replace if different, 1 Replace all, 2 Skip all, 3 Keep
    // both): the rows' actions are set to match.
    callback conflicts-mode-changed(int);
    // The default action and whether to remember it for the site.
    callback conflicts-continue(int, bool);
    callback conflicts-cancel();

    // The delete alert: title, text and the label of the delete button.
    in-out property <bool> delete-open: false;
    in property <string> delete-title;
    in property <string> delete-body;
    in property <string> delete-label;
    callback delete-confirm();
    callback delete-cancel();

    // The New Folder sheet. Create hands the name to the app, which shows `new-folder-error` or
    // closes the sheet (`new-folder-open`); `new-folder-name` is the name the sheet starts with.
    in-out property <bool> new-folder-open: false;
    in property <string> new-folder-name;
    in-out property <string> new-folder-error;
    callback new-folder-create(string);
    callback new-folder-cancel();

    // The Remove Site alert.
    in-out property <bool> remove-site-open: false;
    in property <string> remove-site-title;
    in property <string> remove-site-body;
    callback remove-site-confirm();
    callback remove-site-cancel();

    // The alert for closing the window while transfers are running.
    in-out property <bool> quit-open: false;
    in property <string> quit-title;
    in property <string> quit-body;
    callback quit-pause();
    callback quit-cancel-all();
    callback quit-keep-running();

    // The banners above the panes: each shows while its text is not empty.
    in property <string> resume-banner-text;
    in property <string> offline-banner-text;
    in property <string> auth-banner-text;
    in property <string> clock-banner-text;
    in property <string> disk-banner-text;
    callback resume-banner-resume();
    callback resume-banner-discard();
    callback auth-banner-edit-site();
    callback clock-banner-resume();
    callback disk-banner-resume();

    // The sidebar is shown. The toolbar button flips it; the app may set it too (to restore what
    // the user chose last time).
    in-out property <bool> sidebar-visible: true;
    // Where each pane and its list are, in window coordinates and logical pixels, for telling what
    // a dragged file is over: the pane's rectangle (so a point over the toolbar, the status bar or
    // the gap between the panes is over neither; the panes sit side by side when the main area is
    // wide enough and are stacked otherwise, and the rectangles say which), where its rows start,
    // how far it is scrolled and how many rows it has (see src/drop_hook.rs).
    out property <PaneBounds> local-bounds: local-pane.bounds;
    out property <PaneBounds> remote-bounds: remote-pane.bounds;

    // A drag of the selection of one pane to the other: the pane it began in (0 This PC, 1 the
    // cloud pane; -1 for none) and where the pointer is, in the window. It starts when the pointer
    // has moved 4 px with the button down on a row. Esc ends it (`drag-aborted` then ignores the
    // rest of it until the button comes up).
    property <int> drag-from: -1;
    property <bool> drag-aborted: false;
    property <length> drag-x;
    property <length> drag-y;
    property <int> drag-count: root.drag-from == 0 ? root.local-selected-count : root.remote-selected-count;
    // The other pane is under the pointer, and the folder row of it that is (-1 for none).
    property <bool> drag-over-remote: root.drag-from == 0 && remote-pane.contains(root.drag-x, root.drag-y);
    property <bool> drag-over-local: root.drag-from == 1 && local-pane.contains(root.drag-x, root.drag-y);
    property <int> drag-row-remote: root.drag-over-remote ? remote-pane.folder-at(root.drag-y) : -1;
    property <int> drag-row-local: root.drag-over-local ? local-pane.folder-at(root.drag-y) : -1;
    property <bool> has-selection: root.selected-site >= 0 && root.selected-site < root.sites.length;
    property <bool> can-go-back: root.local-pane-active ? root.local-can-go-back : root.remote-can-go-back;
    property <bool> can-go-forward: root.local-pane-active ? root.local-can-go-forward : root.remote-can-go-forward;

    // A pane reports its drag (see `drag-from`). The first move of a drag starts it.
    function pane-drag-moved(pane: int, point: Point) {
        if (!root.drag-aborted) {
            root.drag-from = pane;
            root.drag-x = point.x;
            root.drag-y = point.y;
        }
    }

    // The button came up: over the other pane the drag drops there, anywhere else it ends.
    function pane-drag-ended(pane: int, point: Point) {
        root.drag-x = point.x;
        root.drag-y = point.y;
        if (!root.drag-aborted && root.drag-from == pane) {
            if (pane == 0 && root.drag-over-remote) {
                root.drag-to-remote(root.drag-row-remote);
            } else if (pane == 1 && root.drag-over-local) {
                root.drag-to-local(root.drag-row-local);
            }
        }
        root.drag-from = -1;
        root.drag-aborted = false;
    }

    function pane-drag-cancelled() {
        root.drag-from = -1;
        root.drag-aborted = false;
    }

    // Turning to the other pane puts its count in the status bar, over any message.
    changed local-pane-active => {
        root.status-message = "";
        root.status-message-pane = -1;
        root.active-pane-changed();
    }

    // Alt+Left and Alt+Right anywhere in the window (but not on the Add Site sheet, which sits
    // outside this scope): the Windows keys for Back and Forward; F5 and Ctrl+R refresh. Not a Tab
    // stop itself.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        // Holds the focus from the start, so that these keys work before anything has been clicked
        // or tabbed to; a pane, a button or a sheet takes it for as long as it needs it, and the
        // keys they do not use reach this scope all the same.
        init => { self.focus(); }
        key-pressed(event) => {
            if (!event.modifiers.alt && !event.modifiers.meta && ((event.text == Key.F5 && !event.modifiers.control) || (event.modifiers.control && (event.text == "r" || event.text == "R")))) {
                if (!event.repeat) {
                    root.refresh();
                }
                return accept;
            }
            // Esc during a drag between the panes gives it up.
            if (event.text == Key.Escape && root.drag-from >= 0) {
                root.drag-from = -1;
                root.drag-aborted = true;
                return accept;
            }
            // Ctrl+U uploads, Ctrl+Shift+N makes a folder and Del deletes, while the toolbar would.
            if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift && (event.text == "u" || event.text == "U")) {
                if (!event.repeat && root.can-upload) {
                    root.upload();
                }
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && (event.text == "n" || event.text == "N")) {
                if (!event.repeat && root.can-new-folder) {
                    root.new-folder();
                }
                return accept;
            }
            if (event.text == Key.Delete && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift) {
                if (!event.repeat && root.can-delete) {
                    root.delete();
                }
                return accept;
            }
            if (event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta) {
                if (event.text == Key.LeftArrow) {
                    if (!event.repeat && root.can-go-back) {
                        root.go-back();
                    }
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    if (!event.repeat && root.can-go-forward) {
                        root.go-forward();
                    }
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            Toolbar {
                title: root.sites.length == 0 ? @tr("Welcome") : (root.has-selection ? root.sites[root.selected-site].name : @tr("HTTPorter"));
                subtitle: root.sites.length == 0 ? @tr("No site connected") : root.endpoint-text;
                connection-text: root.connection-text;
                connection-ok: root.connection-ok;
                can-go-back: root.can-go-back;
                can-go-forward: root.can-go-forward;
                can-upload: root.can-upload;
                can-download: root.can-download;
                can-new-folder: root.can-new-folder;
                can-delete: root.can-delete;
                delete-note: root.delete-note;
                actions-note: root.actions-note;
                toggle-sidebar => { root.sidebar-visible = !root.sidebar-visible; }
                go-back => { root.go-back(); }
                go-forward => { root.go-forward(); }
                upload => { root.upload(); }
                download => { root.download(); }
                new-folder => { root.new-folder(); }
                delete => { root.delete(); }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                // The main area already pads itself by 8 px, so only the sidebar needs the left margin.
                padding-left: root.sidebar-visible ? 8px : 0px;
                padding-top: 8px;
                padding-bottom: 8px;

                if root.sidebar-visible: Sidebar {
                    width: 220px;
                    sites: root.sites;
                    selected-site: root.selected-site;
                    sheet-open: root.add-site-open;
                    settings-available: root.settings-available;
                    site-menu-available: root.sites-v2-ready;
                    site-selected(index) => {
                        root.selected-site = index;
                        root.site-selected(index);
                    }
                    edit-site(index) => { root.site-edit(index); }
                    duplicate-site(index) => { root.site-duplicate(index); }
                    remove-site(index) => { root.site-remove(index); }
                    add-site => {
                        root.add-site-open = true;
                        root.add-site();
                    }
                    open-settings => { root.open-settings(); }
                }

                // Main area: the two file panes, or the Welcome screen while there is no site.
                main-area := Rectangle {
                    horizontal-stretch: 1;

                    // The panes and the transfer drawer. Folded away (and out of the Tab order) behind
                    // the Welcome screen.
                    panes-host := Rectangle {
                        visible: root.sites.length > 0;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 8px;

                            if root.resume-banner-text != "": Banner {
                                text: root.resume-banner-text;
                                icon: Icons.clock;
                                fg: Theme.accent-text;
                                bg: Theme.accent-soft;
                                CapsuleButton {
                                    text: @tr("Resume");
                                    primary: true;
                                    clicked => { root.resume-banner-resume(); }
                                }
                                CapsuleButton {
                                    text: @tr("Discard");
                                    clicked => { root.resume-banner-discard(); }
                                }
                            }
                            if root.offline-banner-text != "": Banner {
                                text: root.offline-banner-text;
                                icon: Icons.warn;
                                fg: Theme.orange;
                                bg: Theme.orange-soft;
                            }
                            if root.auth-banner-text != "": Banner {
                                text: root.auth-banner-text;
                                icon: Icons.lock;
                                fg: Theme.red;
                                bg: Theme.red-soft;
                                // Opens the site the banner names in Edit Site (off until `sites-v2-ready`, Ruling Q10).
                                CapsuleButton {
                                    text: @tr("Edit Site…");
                                    enabled: root.sites-v2-ready;
                                    accessible-description: root.sites-v2-ready ? "" : @tr("Arrives later in this build.");
                                    clicked => { root.auth-banner-edit-site(); }
                                }
                            }
                            // The PC's clock is off for the site it names (review I4): once it is
                            // set, Resume carries on with the same site.
                            if root.clock-banner-text != "": Banner {
                                text: root.clock-banner-text;
                                icon: Icons.clock;
                                fg: Theme.orange;
                                bg: Theme.orange-soft;
                                CapsuleButton {
                                    text: @tr("Resume");
                                    clicked => { root.clock-banner-resume(); }
                                }
                            }
                            if root.disk-banner-text != "": Banner {
                                text: root.disk-banner-text;
                                icon: Icons.warn;
                                fg: Theme.orange;
                                bg: Theme.orange-soft;
                                CapsuleButton {
                                    text: @tr("Resume");
                                    clicked => { root.disk-banner-resume(); }
                                }
                            }
                            if root.error-text != "": ErrorBanner {
                                text: root.error-text;
                                offer-edit: root.remote-offer-edit && root.sites-v2-ready && root.has-selection;
                                edit => { root.site-edit(root.selected-site); }
                                remove => { root.site-remove(root.selected-site); }
                            }

                            // Side by side when each pane can have the mockup's 420 px, stacked otherwise
                            // (mockup `.panes`: a wrapping row). The panes are placed by hand rather than in a
                            // layout so that they keep their state when the window crosses that width.
                            panes := Rectangle {
                                property <bool> side-by-side: self.width >= 2 * 420px + 8px;

                                vertical-stretch: 1;

                                local-pane := Pane {
                                    x: 0px;
                                    y: 0px;
                                    width: panes.side-by-side ? (panes.width - 8px) / 2 : panes.width;
                                    height: panes.side-by-side ? panes.height : (panes.height - 8px) / 2;
                                    title: @tr("This PC");
                                    changed has-focus => {
                                        if (self.has-focus) {
                                            root.local-pane-active = true;
                                        }
                                    }
                                    icon: Icons.pc;
                                    crumbs: root.local-crumbs;
                                    rows: root.local-rows;
                                    loading: root.local-loading;
                                    drop-hover: root.drag-over-local;
                                    drop-row: root.drag-row-local;
                                    can-upload: root.can-upload;
                                    can-download: root.can-download;
                                    can-new-folder: root.can-new-folder;
                                    can-delete: root.can-delete;
                                    selected <=> root.local-selected;
                                    sort-column <=> root.local-sort-column;
                                    sort-ascending <=> root.local-sort-ascending;
                                    open(index) => { root.open-local(index); }
                                    up => { root.local-up(); }
                                    crumb-clicked(index) => { root.local-crumb-clicked(index); }
                                    sort(column) => { root.sort-local(column); }
                                    row-pointer(row, ctrl, shift) => { root.row-pointer(0, row, ctrl, shift); }
                                    band-select(from, to, additive) => { root.band-select(0, from, to, additive); }
                                    select-all => { root.select-all(0); }
                                    upload => { root.upload(); }
                                    download => { root.download(); }
                                    download-to => { root.download-to(); }
                                    new-folder => { root.new-folder(); }
                                    delete => { root.delete(); }
                                    // The pane's own Refresh (button or menu) lists this pane, whichever was last used.
                                    refresh => {
                                        root.local-pane-active = true;
                                        root.refresh();
                                    }
                                    key-inside => { root.local-pane-active = true; }
                                    show-in-explorer(row) => { root.show-in-explorer(row); }
                                    drag-moved(point) => { root.pane-drag-moved(0, point); }
                                    drag-ended(point) => { root.pane-drag-ended(0, point); }
                                    drag-cancelled => { root.pane-drag-cancelled(); }
                                }
                                remote-pane := Pane {
                                    x: panes.side-by-side ? (panes.width + 8px) / 2 : 0px;
                                    y: panes.side-by-side ? 0px : (panes.height + 8px) / 2;
                                    width: panes.side-by-side ? (panes.width - 8px) / 2 : panes.width;
                                    height: panes.side-by-side ? panes.height : (panes.height - 8px) / 2;
                                    title: root.has-selection ? root.sites[root.selected-site].name : @tr("No site selected");
                                    changed has-focus => {
                                        if (self.has-focus) {
                                            root.local-pane-active = false;
                                        }
                                    }
                                    icon: Icons.cloud;
                                    crumbs: root.remote-crumbs;
                                    rows: root.remote-rows;
                                    header-chip: root.remote-chip;
                                    loading: root.remote-loading;
                                    can-refresh: root.has-selection;
                                    drop-hover: (root.drop-hover-remote && root.has-selection) || root.drag-over-remote;
                                    drop-row: root.drag-over-remote ? root.drag-row-remote : (root.drop-hover-remote ? root.drop-hover-row : -1);
                                    cloud: true;
                                    can-upload: root.can-upload;
                                    can-download: root.can-download;
                                    can-new-folder: root.can-new-folder;
                                    can-delete: root.can-delete;
                                    selected <=> root.remote-selected;
                                    sort-column <=> root.remote-sort-column;
                                    sort-ascending <=> root.remote-sort-ascending;
                                    open(index) => { root.open-remote(index); }
                                    up => { root.remote-up(); }
                                    crumb-clicked(index) => { root.remote-crumb-clicked(index); }
                                    sort(column) => { root.sort-remote(column); }
                                    row-pointer(row, ctrl, shift) => { root.row-pointer(1, row, ctrl, shift); }
                                    band-select(from, to, additive) => { root.band-select(1, from, to, additive); }
                                    select-all => { root.select-all(1); }
                                    upload => { root.upload(); }
                                    download => { root.download(); }
                                    download-to => { root.download-to(); }
                                    new-folder => { root.new-folder(); }
                                    delete => { root.delete(); }
                                    refresh => {
                                        root.local-pane-active = false;
                                        root.refresh();
                                    }
                                    key-inside => { root.local-pane-active = false; }
                                    show-in-explorer(row) => { root.show-in-explorer(row); }
                                    paste => { root.paste(); }
                                    drag-moved(point) => { root.pane-drag-moved(1, point); }
                                    drag-ended(point) => { root.pane-drag-ended(1, point); }
                                    drag-cancelled => { root.pane-drag-cancelled(); }
                                }
                            }

                            TransferDrawer {
                                open <=> root.transfers-open;
                                tab <=> root.transfers-tab;
                                running: root.transfers-running;
                                paused: root.transfers-paused;
                                collapsed-text: root.transfers-collapsed-text;
                                title: root.transfers-title;
                                line: root.transfers-line;
                                files-per-s: root.transfers-files-per-s;
                                mb-per-s: root.transfers-mb-per-s;
                                eta: root.transfers-eta;
                                percent: root.transfers-percent;
                                tab-titles: root.transfers-tab-titles;
                                active-rows: root.transfers-active;
                                queued-rows: root.transfers-queued;
                                failed-rows: root.transfers-failed;
                                done-rows: root.transfers-done;
                                toggle => { root.transfers-toggle(); }
                                pause => { root.transfers-pause(); }
                                resume => { root.transfers-resume(); }
                                cancel-all => { root.transfers-cancel-all(); }
                                cancel(id) => { root.transfer-cancel(id); }
                                retry(id) => { root.transfer-retry(id); }
                                retry-failed => { root.transfers-retry-failed(); }
                                move-to-top(id) => { root.transfer-move-to-top(id); }
                                pause-row(id) => { root.transfer-pause(id); }
                                resume-row(id) => { root.transfer-resume(id); }
                            }
                        }
                    }

                    if root.sites.length == 0: WelcomeView {
                        v2-ready: root.sites-v2-ready;
                        add-first => {
                            root.add-site-open = true;
                            root.add-site();
                            root.welcome-add();
                        }
                        import-profiles => { root.welcome-import(); }
                    }
                }
            }

            StatusBar {
                left-text: root.status-left;
                right-text: root.status-right;
            }
        }
    }

    // The dragged selection following the pointer: "3 items" in an accent pill. Takes no pointer
    // events of its own.
    if root.drag-from >= 0: Rectangle {
        x: root.drag-x + 14px;
        y: root.drag-y + 14px;
        width: ghost-text.preferred-width + 20px;
        height: 24px;
        background: Theme.accent;
        border-radius: self.height / 2;
        accessible-role: none;

        ghost-text := Text {
            x: 10px;
            width: self.preferred-width;
            height: parent.height;
            text: @tr("{n} item" | "{n} items" % root.drag-count);
            color: Theme.on-accent;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }

    // On top of everything else, so that it also dims the toolbar and swallows the pointer.
    if root.add-site-open: AddSiteSheet {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        region-names: root.region-names;
        endpoint: root.add-site-endpoint;
        result <=> root.add-site-result;
        result-ok: root.add-site-result-ok;
        busy: root.add-site-busy;
        zone-error <=> root.add-site-zone-error;
        region-error <=> root.add-site-region-error;
        password-error <=> root.add-site-password-error;
        key-error <=> root.add-site-key-error;
        s3-errors <=> root.add-site-s3-errors;
        error-serial: root.add-site-error-serial;
        v2-ready: root.sites-v2-ready;
        editing: root.add-site-editing;
        secret-imported: root.add-site-secret-imported;
        draft: root.add-site-draft;
        zones: root.add-site-zones;
        zone-checked <=> root.add-site-zone-checked;
        zone-count <=> root.add-site-zone-count;
        buckets: root.add-site-buckets;
        buckets-busy: root.add-site-buckets-busy;
        buckets-error: root.add-site-buckets-error;
        changed(zone, region) => { root.add-site-changed(zone, region); }
        s3-changed(draft) => { root.add-site-s3-changed(draft); }
        test(name, zone, region, password) => { root.add-site-test(name, zone, region, password); }
        save(name, zone, region, password) => { root.add-site-save(name, zone, region, password); }
        test-s3(draft, secret) => { root.add-site-test-s3(draft, secret); }
        save-s3(draft, secret) => { root.add-site-save-s3(draft, secret); }
        provider-chosen(index) => { root.add-site-provider(index); }
        sign-in-chosen(index) => { root.add-site-sign-in-mode(index); }
        find-zones(key) => { root.add-site-find-zones(key); }
        zones-chosen(checked, keep) => { root.add-site-zones-chosen(checked, keep); }
        list-buckets(draft, secret) => { root.add-site-list-buckets(draft, secret); }
        reveal => { root.add-site-reveal(); }
        cancel => {
            root.add-site-open = false;
            root.add-site-cancel();
        }
    }

    // The sheets and alerts, also on top of everything, each closing itself before it says what
    // was chosen (so that the app may open the next one in answer).
    if root.conflicts-open: ConflictSheet {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title: root.conflicts-title;
        body: root.conflicts-body;
        for-all-label: root.conflicts-for-all;
        summary: root.conflicts-summary;
        col-source: root.conflicts-col-source;
        col-target: root.conflicts-col-target;
        remember-label: root.conflicts-remember;
        cancel-label: root.conflicts-cancel-label;
        rows <=> root.conflicts-rows;
        mode-changed(mode) => { root.conflicts-mode-changed(mode); }
        continued(mode, remember) => {
            root.conflicts-open = false;
            root.conflicts-continue(mode, remember);
        }
        cancelled => {
            root.conflicts-open = false;
            root.conflicts-cancel();
        }
    }
    if root.delete-open: DeleteAlert {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title: root.delete-title;
        body: root.delete-body;
        delete-label: root.delete-label;
        confirmed => {
            root.delete-open = false;
            root.delete-confirm();
        }
        cancelled => {
            root.delete-open = false;
            root.delete-cancel();
        }
    }
    if root.new-folder-open: NewFolderSheet {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        initial-name: root.new-folder-name;
        error <=> root.new-folder-error;
        create(name) => { root.new-folder-create(name); }
        cancelled => {
            root.new-folder-open = false;
            root.new-folder-cancel();
        }
    }
    if root.remove-site-open: RemoveSiteAlert {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title: root.remove-site-title;
        body: root.remove-site-body;
        confirmed => {
            root.remove-site-open = false;
            root.remove-site-confirm();
        }
        cancelled => {
            root.remove-site-open = false;
            root.remove-site-cancel();
        }
    }
    if root.import-open: ImportSheet {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        profiles: root.import-profiles;
        error <=> root.import-error;
        profile-chosen(index) => {
            root.import-open = false;
            root.import-profile(index);
        }
        env-file => { root.import-env(); }
        cancelled => {
            root.import-open = false;
            root.import-cancel();
        }
    }
    if root.quit-open: QuitAlert {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title: root.quit-title;
        body: root.quit-body;
        pause-and-quit => {
            root.quit-open = false;
            root.quit-pause();
        }
        cancel-and-quit => {
            root.quit-open = false;
            root.quit-cancel-all();
        }
        keep-running => {
            root.quit-open = false;
            root.quit-keep-running();
        }
    }
}
