// Design tokens, copied from docs/design/mockups/app.css (light and dark).
// Alpha values are the CSS rgba() alphas rounded to the nearest 1/255.

import { Palette } from "std-widgets.slint";
import { ProviderTile } from "types.slint";

export global Theme {
    // Settings › General › Appearance (I4): 0 follows the system, 1 light, 2 dark. A global is
    // per window: the app sets it on the main window and the Settings window.
    in-out property <int> appearance: 0;
    out property <bool> dark: appearance == 2 || (appearance == 0 && Palette.color-scheme == ColorScheme.dark);

    // Windows' text size (Settings › Accessibility › Text size, 1.0 to 2.25) and "Animation
    // effects": the app sets both at start from `win::text_scale()` / `win::animations_enabled()`,
    // and again when Windows' settings change (src/settings_view.rs). Every `animate` is
    // `duration: Theme.motion ? Nms : 0ms`, so that turning animations off in Windows stops them.
    in property <float> text-scale: 1.0;
    // Windows' "Animation effects" (`system-motion`) and Settings › General › Animations
    // (`animations`: 0 follows Windows, 1 on, 2 off, I7) make `motion`.
    in property <bool> system-motion: true;
    in-out property <int> animations: 0;
    out property <bool> motion: animations == 1 || (animations == 0 && system-motion);

    // Motion (I7, docs/superpowers/plans/2026-11-10-httporter-i7-motion.md): one set of timings,
    // as Apple's and Fluent's are. With "Animation effects" off in Windows they are 1 ms, which
    // snaps (a spring needs a duration above zero). Springs: `easing: spring(<bounce>)`.
    // A colour fade on hover or press.
    out property <duration> motion-hover: motion ? 100ms : 1ms;
    // A control changing state: a switch, a segment, a chevron.
    out property <duration> motion-control: motion ? 250ms : 1ms;
    // A panel: the sidebar, the drawer, a row coming or going, a toast.
    out property <duration> motion-panel: motion ? 300ms : 1ms;
    // A sheet, an alert, Quick Look, the palette coming in.
    out property <duration> motion-sheet: motion ? 350ms : 1ms;
    // Something leaving: shorter than its arrival.
    out property <duration> motion-exit: motion ? 200ms : 1ms;

    // Accent. `accent` is for fills behind white text; `accent-text` is the accent used as text.
    out property <color> accent: #0071e3;
    out property <color> accent-text: dark ? #5aa9ff : #0066cc;
    // Keyboard focus rings. At least 3:1, with room to spare, against every surface a ring is
    // drawn on (ledger 154): light 4.6:1 on the sidebar (its darkest), 5.6:1 on white; dark 5.8:1
    // on the sidebar, 4.6:1 on a control's face. The accent itself is only 3.05:1 on the dark
    // sidebar.
    out property <color> focus-ring: dark ? #5aa9ff : #0066cc;
    out property <color> on-accent: #ffffff;
    out property <color> accent-soft: dark ? #0a84ff33 : #0071e31f;

    // Status colours and their tinted chip backgrounds.
    out property <color> red: dark ? #ff7a72 : #c4001a;
    out property <color> red-soft: dark ? #ff453a29 : #d700151a;
    out property <color> green: dark ? #4cd964 : #1d7a35;
    out property <color> green-soft: dark ? #30d15829 : #248a3d1f;
    out property <color> orange: dark ? #ffad33 : #b03000;
    out property <color> orange-soft: dark ? #ff9f0a29 : #c934001a;
    out property <color> purple: dark ? #d39cff : #7a3aa0;
    out property <color> purple-soft: dark ? #bf5af22e : #8944ab1f;
    out property <color> folder: dark ? #5aa9ff : #2f8fe8;

    // Provider brand colours behind the tiles (mockup `providers`): the same in light and dark.
    // The tile's letters are white on them, at least 4.8:1 each (ledger 128: Bunny's #e8590c and
    // S3's #3a7bd5 were darkened a little for that).
    out property <color> provider-bunny: #c04f0a;
    out property <color> provider-s3: #3070c8;
    out property <color> provider-r2: #c2410c;
    out property <color> provider-b2: #b42318;
    out property <color> provider-wasabi: #1f7a3a;
    out property <color> provider-do: #1d4ed8;
    out property <color> provider-minio: #b91c1c;
    out property <color> provider-other: #5c5c62;
    // The tile's letters.
    out property <color> tile-text: #ffffff;
    // The tile colour for a site's provider (`SiteItem.provider`). Every tile is named, `other`
    // too, so that a tile added to `ProviderTile` and not mapped here shows in the accent rather
    // than passing for "Other" unnoticed (ledger 123).
    pure public function provider-tint(provider: ProviderTile) -> color {
        return provider == ProviderTile.bunny ? provider-bunny
            : provider == ProviderTile.s3 ? provider-s3
            : provider == ProviderTile.r2 ? provider-r2
            : provider == ProviderTile.b2 ? provider-b2
            : provider == ProviderTile.wasabi ? provider-wasabi
            : provider == ProviderTile.digital-ocean ? provider-do
            : provider == ProviderTile.minio ? provider-minio
            : provider == ProviderTile.other ? provider-other
            : accent;
    }

    // Text.
    out property <color> label: dark ? #f5f5f7 : #1d1d1f;
    out property <color> label2: dark ? #a8a8ad : #5c5c62;
    // Tertiary: chevrons, marks and turned-off text. At least 3.5:1 on every surface (the
    // sidebar is the darkest light one and the lightest dark one), as marks that say something
    // need 3:1 (WCAG 1.4.11).
    out property <color> label3: dark ? #808086 : #7a7a80;

    // Surfaces.
    out property <color> win: dark ? #1b1b1d : #f2f2f5;
    out property <color> chrome: dark ? #232325 : #f7f7f9;
    out property <color> content: dark ? #1e1e20 : #ffffff;
    out property <color> sidebar: dark ? #2a2a2d : #eaeaee;
    out property <color> row-alt: dark ? #232326 : #f7f7f9;
    out property <color> sheet: dark ? #2a2a2d : #ffffff;
    out property <color> scrim: dark ? #00000080 : #1e1e2838;
    out property <color> shadow-sheet: dark ? #00000099 : #00000038;
    // The app icon tile on the Add Site sheet (mockup `.appicon`: a 160 degree gradient).
    out property <color> app-icon-top: #3a8dff;
    out property <color> app-icon-bottom: #0058c7;

    // Lines, hover and selection.
    out property <color> sep: dark ? #ffffff17 : #00000017;
    out property <color> sep-strong: dark ? #ffffff29 : #00000029;
    out property <color> hover: dark ? #ffffff0d : #0000000a;
    out property <color> sel: #0071e3;
    out property <color> sel-text: #ffffff;
    out property <color> sel-quiet: dark ? #ffffff1a : #00000012;

    // Controls.
    out property <color> control: dark ? #3a3a3d : #ffffff;
    out property <color> control-border: dark ? #ffffff1a : #00000021;
    out property <color> shadow-control: dark ? #00000080 : #00000029;
    out property <color> field: dark ? #2c2c2f : #ffffff;
    // Outline of text fields, pickers and plain buttons: at least 3:1 against the surface behind
    // (WCAG 1.4.11), which the hairline `control-border` is not. With margin (ledger 219): light
    // 3.6:1 on the sidebar, 3.7:1 on white; dark 3.6:1 on the sidebar, 3.8:1 on the content.
    out property <color> field-border: dark ? #ffffff66 : #0000007a;
    out property <color> chip: dark ? #ffffff14 : #0000000d;

    // Type. Every size follows Windows' text size (`text-scale`); so do the heights that hold a
    // line of text (`grow` is how much taller a line of body text is than at 100 %).
    out property <string> font-family: "Inter";
    // The app sets it from what is installed (ledger 135).
    in-out property <string> font-mono: "Cascadia Mono";
    out property <length> font-tile: 9px * text-scale;
    out property <length> font-mini: 10px * text-scale;
    out property <length> font-small: 11px * text-scale;
    out property <length> font-caption: 12px * text-scale;
    out property <length> font-body: 13px * text-scale;
    out property <length> font-callout: 14px * text-scale;
    out property <length> font-title: 15px * text-scale;
    out property <length> font-headline: 17px * text-scale;
    out property <length> font-large: 20px * text-scale;
    out property <length> font-display: 34px * text-scale;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
    out property <length> grow: font-body - 13px;
    out property <length> grow-small: font-small - 11px;

    // Metrics. Capsule controls are fully rounded: use `self.height / 2` for their radius.
    out property <length> row-height: 28px + grow;
    out property <length> sidebar-item-height: 28px + grow;
    out property <length> toolbar-height: 52px + grow;
    out property <length> statusbar-height: 28px + grow-small;
    // A capsule button, a tab of a segmented control, a chip, the provider tile.
    out property <length> control-height: 28px + grow;
    out property <length> control-small-height: 22px + grow-small;
    out property <length> tab-height: 24px + grow;
    out property <length> chip-height: 20px + grow-small;
    out property <length> tile-size: 2 * font-tile;
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 14px;
    out property <length> radius-xl: 18px;
}
