// Transfer drawer (mockup `.drawer`, see Transfers.dc.html): a card at the bottom of the main area,
// never a window of its own. Collapsed it is one line, the state in words and "Show Transfers".
// Expanded it has the progress ring, the title and counts, the speed, the Active / Queued / Failed /
// Done tabs with Pause and Cancel, and a virtualized list of rows with a kind icon, the path, the
// size, a progress bar and a cancel button.
//
// It only shows what the app tells it and says what the user pressed: the row buttons hand back the
// job's id. Keyboard: Tab reaches Show / Hide Transfers, the tabs, the buttons and each row's
// buttons; Space or Return presses one. The right-click menu of a queued row has Move to Top and
// Pause / Resume.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { FileKind, TransferRow } from "../types.slint";
import { Activation, CapsuleButton, ToolButton } from "buttons.slint";
import { VCenter } from "layout.slint";

// Round progress (mockup `.ring`): a track with a dot for each tenth of a turn that is done,
// clockwise from the top. Dots, not an arc, because the software renderer draws no paths.
export component ProgressRing inherits Rectangle {
    // 0 to 100.
    in property <float> percent;
    in property <length> diameter: 34px;
    property <length> stroke: root.diameter * 4 / 34;

    width: root.diameter;
    height: root.diameter;
    border-radius: root.diameter / 2;
    border-width: root.stroke;
    border-color: Theme.chip;
    accessible-role: progress-indicator;
    accessible-label: @tr("{} percent done", Math.round(root.percent));

    for k in 36: Rectangle {
        property <angle> theta: k * 10deg;

        width: root.stroke;
        height: root.stroke;
        x: root.diameter / 2 + (root.diameter - root.stroke) / 2 * Math.sin(self.theta) - root.stroke / 2;
        y: root.diameter / 2 - (root.diameter - root.stroke) / 2 * Math.cos(self.theta) - root.stroke / 2;
        border-radius: root.stroke / 2;
        background: Theme.accent;
        visible: k * 100 / 36 < root.percent;
    }
}

// A button with no face of its own, in the accent colour (mockup `.btn.quiet`): Show Transfers and
// Hide Transfers. Reachable with Tab, activated with Space or Return.
component QuietButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    height: Theme.control-height;
    border-radius: self.height / 2;
    background: area.pressed ? Theme.sel-quiet : (area.has-hover ? Theme.hover : transparent);
    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.motion-hover; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 4px;
        alignment: center;

        Text {
            text: root.text;
            color: Theme.accent-text;
            font-size: Theme.font-body;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            accessible-role: none;
        }
        VCenter {
            Image {
                source: root.icon;
                colorize: Theme.accent-text;
                width: 14px;
                height: 14px;
                accessible-role: none;
            }
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    // Zero width so that clicks do not focus it (the ring is for keyboard focus only).
    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One tab of the strip (mockup `.tabs button`). Reachable with Tab, selected with Space or Return.
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    height: Theme.tab-height;
    border-radius: 6px;
    background: root.selected ? Theme.control : (area.has-hover ? Theme.hover : transparent);
    border-width: root.selected ? 1phx : 0px;
    border-color: Theme.control-border;
    forward-focus: key-focus;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.text;
            color: Theme.label;
            font-size: Theme.font-caption;
            font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The number and the unit of one speed in the header (mockup `.stats`): the number in the label
// colour, the unit in the secondary one.
component Stat inherits HorizontalLayout {
    in property <string> value;
    in property <string> unit;

    spacing: 3px;

    Text {
        text: root.value;
        color: Theme.label;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
    }
    Text {
        text: root.unit;
        color: Theme.label2;
        font-size: Theme.font-caption;
        vertical-alignment: center;
    }
}

// The icon, the tint and the spoken name for each kind of file.
export global KindStyle {
    pure public function icon(kind: FileKind) -> image {
        return kind == FileKind.folder ? Icons.folder : kind == FileKind.code ? Icons.code : kind == FileKind.image ? Icons.image : Icons.doc;
    }
    pure public function tint(kind: FileKind) -> color {
        return kind == FileKind.folder ? Theme.folder : kind == FileKind.image ? Theme.green : Theme.label2;
    }
}

// One row of the list (mockup `.qrow`): kind icon and path, then the progress bar (Active), the
// reason (Failed) or "Paused" (Queued), the size, the percentage or Retry, and the cancel button.
// A queued row also has the right-click menu.
component TransferItem inherits Rectangle {
    in property <TransferRow> item;
    // 0 Active, 1 Queued, 2 Failed, 3 Done.
    in property <int> tab;
    in property <int> index;
    in property <int> count;
    // M11: the row is in the Failed tab's selection.
    in property <bool> chosen;
    callback cancel();
    callback retry();
    callback move-to-top();
    callback pause();
    callback resume();
    // M11: a click on a Failed row, with Ctrl and Shift.
    callback row-clicked(bool, bool);

    property <int> percent: Math.round(root.item.percent);
    // I7: the bar eases to each new value (`Theme.motion-panel`) while it shows the same job. The
    // list hands a row to another job as jobs finish (it is kept up to date row by row), and the
    // bar snaps then. `bar` is what it shows, 0 to 100.
    property <float> bar: 0;
    property <int> bar-job: -1;
    property <bool> bar-eases: false;
    // The job is all sent but still in the Active list: a check takes the bar's place.
    property <bool> finished: root.tab == 0 && root.item.percent >= 100;

    animate bar {
        duration: root.bar-eases ? Theme.motion-panel : 0ms;
        easing: ease-out;
    }

    function place-bar() {
        root.bar-eases = root.item.id == root.bar-job;
        root.bar-job = root.item.id;
        root.bar = Math.min(Math.max(root.item.percent, 0), 100);
    }

    init => { root.place-bar(); }
    changed item => { root.place-bar(); }

    height: Theme.row-height + 2px;
    background: root.chosen ? Theme.accent-soft : transparent;
    accessible-role: list-item;
    accessible-item-selected: root.chosen;
    accessible-label: root.tab == 0 ? @tr("{}, {}, {} percent", root.item.name, root.item.size, root.percent)
        : root.tab == 1 ? (root.item.paused ? @tr("{}, {}, paused", root.item.name, root.item.size) : @tr("{}, {}, waiting", root.item.name, root.item.size))
        : root.tab == 2 ? @tr("{}, {}, failed: {}", root.item.name, root.item.size, root.item.detail)
        : @tr("{}, {}, done", root.item.name, root.item.size);
    accessible-item-index: root.index;
    accessible-item-count: root.count;

    // M11: Failed rows are picked with a click, Ctrl+click and Shift+click (the buttons on the row
    // sit above this and keep their clicks).
    if root.tab == 2: TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.row-clicked(event.modifiers.control, event.modifiers.shift);
            }
        }
    }

    ContextMenuArea {
        enabled: root.tab == 1;
        width: parent.width;
        height: parent.height;

        Menu {
            MenuItem {
                title: @tr("Move to Top");
                activated => { root.move-to-top(); }
            }
            MenuItem {
                title: root.item.paused ? @tr("Resume") : @tr("Pause");
                activated => {
                    if (root.item.paused) {
                        root.resume();
                    } else {
                        root.pause();
                    }
                }
            }
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;

                HorizontalLayout {
                    spacing: 8px;

                    VCenter {
                        Image {
                            source: KindStyle.icon(root.item.kind);
                            colorize: KindStyle.tint(root.item.kind);
                            width: 14px;
                            height: 14px;
                            accessible-role: none;
                        }
                    }
                    Text {
                        text: root.item.name;
                        color: Theme.label;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
            }

            // The progress bar (mockup `.bar`), or what is to be said instead of one.
            Rectangle {
                width: root.tab == 2 ? 240px : 160px;

                if root.tab == 0: VCenter {
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.chip;
                        clip: true;
                        // Cross-fades to the check once the job is all sent (I7).
                        opacity: root.finished ? 0 : 1;

                        animate opacity { duration: Theme.motion-control; easing: ease-in-out; }

                        Rectangle {
                            x: 0;
                            width: parent.width * root.bar / 100;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                }
                if root.tab == 0: Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: Icons.check;
                    colorize: Theme.green;
                    opacity: root.finished ? 1 : 0;
                    accessible-role: none;

                    animate opacity { duration: Theme.motion-control; easing: ease-in-out; }
                }
                if root.tab == 1 || root.tab == 2: Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.item.detail;
                    color: root.tab == 2 ? Theme.red : Theme.label2;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }

            Text {
                text: root.item.size;
                width: 70px;
                color: Theme.label2;
                font-size: Theme.font-caption;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            Rectangle {
                width: 60px;

                if root.tab == 0: Text {
                    width: parent.width;
                    height: parent.height;
                    text: @tr("{}%", root.percent);
                    color: Theme.label2;
                    font-size: Theme.font-caption;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                if root.tab == 2: VCenter {
                    CapsuleButton {
                        height: Theme.control-small-height;
                        text: @tr("Retry");
                        clicked => { root.retry(); }
                    }
                }
            }

            Rectangle {
                width: 24px;

                if root.tab == 0 || root.tab == 1: VCenter {
                    ToolButton {
                        width: 24px;
                        height: Theme.control-small-height;
                        icon: Icons.x;
                        label: @tr("Cancel {}", root.item.name);
                        clicked => { root.cancel(); }
                    }
                }
            }
        }
    }

    // The hairline under the row (mockup: border-bottom).
    Rectangle {
        y: parent.height - self.height;
        height: 1px;
        background: Theme.sep;
    }
}

export component TransferDrawer inherits Rectangle {
    // Expanded or collapsed. The Show / Hide Transfers button flips it.
    in-out property <bool> open: false;
    // The tab shown: 0 Active, 1 Queued, 2 Failed, 3 Done.
    in-out property <int> tab: 0;
    // The engine has work (running, paused or stopped), not idle.
    in property <bool> running;
    in property <bool> paused;
    in property <string> collapsed-text;
    in property <string> title;
    in property <string> line;
    // The numbers of the speeds, without their units, and the time left (empty when not known).
    in property <string> files-per-s;
    in property <string> mb-per-s;
    in property <string> eta;
    // Overall progress, 0 to 100.
    in property <float> percent;
    // "Active 32", "Queued 5,349", "Failed 0", "Done 8,412".
    in property <[string]> tab-titles;
    in property <[TransferRow]> active-rows;
    in property <[TransferRow]> queued-rows;
    in property <[TransferRow]> failed-rows;
    in property <[TransferRow]> done-rows;

    callback toggle();
    callback pause();
    callback resume();
    callback cancel-all();
    // The row buttons carry the job's id.
    callback cancel(int);
    callback retry(int);
    callback retry-failed();
    callback move-to-top(int);
    callback pause-row(int);
    callback resume-row(int);
    // M11: Retry Selected on the Failed tab. The selection is the rows from the first to the
    // second number (indexes into the Failed rows; none when the first is below 0), each flipped
    // when its `selected` equals the third (Ctrl+click); the app works the ids out from that.
    callback retry-selected([int]);

    // M11: the Failed tab's selection (see `retry-selected`). `sel-gen` goes up to clear the
    // Ctrl+clicks.
    property <int> sel-gen: 1;
    property <int> sel-lo: -1;
    property <int> sel-hi: -1;
    property <int> sel-anchor: -1;
    property <bool> has-selection: false;

    property <[TransferRow]> shown-rows: root.tab == 0 ? root.active-rows : (root.tab == 1 ? root.queued-rows : (root.tab == 2 ? root.failed-rows : root.done-rows));
    // The list shows up to six rows and leaves room for one line when it is empty.
    property <length> list-height: Math.min(Math.max(root.shown-rows.length, 1), 6) * (Theme.row-height + 2px);
    // The header: 10 px of padding round the ring's row (34 px), 8 px, and the tabs' row (28 px).
    // With larger text the title's two lines and the tabs' row grow.
    property <length> head-height: 90px + 3 * Theme.grow;

    background: Theme.content;
    border-radius: Theme.radius-md;
    border-width: 1phx;
    border-color: Theme.sep-strong;
    clip: true;
    // I7: opening and closing slide (`Theme.motion-panel`, a spring with no bounce). The content
    // keeps its own height, at the top of the card, and the card's clip reveals it: nothing in it is
    // laid out again while the card moves. The panes above follow the card's height.
    property <length> collapsed-height: 48px + Theme.grow;
    property <length> open-height: root.head-height + root.list-height + 1px;
    height: root.open ? root.open-height : root.collapsed-height;
    accessible-role: groupbox;

    animate height { duration: Theme.motion-panel; easing: spring(0); }
    accessible-label: @tr("Transfers");

    // Collapsed: the state in words, and Show Transfers.
    if !root.open: HorizontalLayout {
        y: 0;
        width: parent.width;
        height: root.collapsed-height;
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        VCenter {
            if root.running: ProgressRing {
                diameter: 20px;
                percent: root.percent;
            }
            if !root.running: Image {
                source: Icons.check;
                colorize: Theme.green;
                width: 16px;
                height: 16px;
                accessible-role: none;
            }
        }
        Text {
            text: root.collapsed-text;
            horizontal-stretch: 1;
            color: Theme.label;
            font-size: Theme.font-body;
            font-weight: root.running ? Theme.weight-semibold : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
        }
        VCenter {
            QuietButton {
                text: @tr("Show Transfers");
                icon: Icons.chev-u;
                clicked => {
                    root.open = true;
                    root.toggle();
                }
            }
        }
    }

    // Expanded: the header, then the list.
    if root.open: VerticalLayout {
        y: 0;
        width: parent.width;
        height: root.open-height;

        VerticalLayout {
            height: root.head-height;
            padding: 10px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 12px;

                VCenter {
                    ProgressRing {
                        diameter: 34px;
                        percent: root.percent;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    alignment: center;

                    Text {
                        text: root.title;
                        color: Theme.label;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-semibold;
                        overflow: elide;
                    }
                    Text {
                        text: root.line;
                        color: Theme.label2;
                        font-size: Theme.font-caption;
                        overflow: elide;
                    }
                }
                if root.running: VCenter {
                    HorizontalLayout {
                        spacing: 16px;

                        Stat {
                            value: root.files-per-s;
                            unit: @tr("files/s");
                        }
                        Stat {
                            value: root.mb-per-s;
                            unit: @tr("MB/s");
                        }
                        if root.eta != "": HorizontalLayout {
                            spacing: 3px;

                            Text {
                                text: @tr("about");
                                color: Theme.label2;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.eta;
                                color: Theme.label;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-semibold;
                                vertical-alignment: center;
                            }
                            Text {
                                text: @tr("left");
                                color: Theme.label2;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                VCenter {
                    QuietButton {
                        text: @tr("Hide Transfers");
                        icon: Icons.chev-d;
                        clicked => {
                            root.open = false;
                            root.toggle();
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                if root.tab == 2 && root.failed-rows.length > 0: CapsuleButton {
                    text: @tr("Retry All");
                    icon: Icons.refresh;
                    clicked => { root.retry-failed(); }
                }
                if root.tab == 2 && root.failed-rows.length > 0 && root.has-selection: CapsuleButton {
                    text: @tr("Retry Selected");
                    clicked => {
                        root.retry-selected([root.sel-lo, root.sel-hi, root.sel-gen]);
                        root.sel-gen += 1;
                        root.sel-lo = -1;
                        root.sel-hi = -1;
                        root.sel-anchor = -1;
                        root.has-selection = false;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // The tabs (mockup `.tabs`): a capsule tray with the chosen tab raised.
                Rectangle {
                    height: Theme.tab-height + 4px;
                    border-radius: 8px;
                    background: Theme.chip;
                    accessible-role: tab-list;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        for name[i] in root.tab-titles: TabButton {
                            text: name;
                            selected: i == root.tab;
                            clicked => { root.tab = i; }
                        }
                    }
                }
                if !root.paused: CapsuleButton {
                    text: @tr("Pause");
                    icon: Icons.pause;
                    enabled: root.running;
                    clicked => { root.pause(); }
                }
                if root.paused: CapsuleButton {
                    text: @tr("Resume");
                    clicked => { root.resume(); }
                }
                CapsuleButton {
                    text: @tr("Cancel");
                    enabled: root.running;
                    clicked => { root.cancel-all(); }
                }
            }
        }

        // The list, with a hairline above it. The list view insets its content by 2 px on every
        // side; it reaches out by that much so that the rows run edge to edge.
        Rectangle {
            height: root.list-height + 1px;

            Rectangle {
                height: 1px;
                background: Theme.sep;
            }
            Rectangle {
                y: 1px;
                height: parent.height - 1px;
                clip: true;

                if root.shown-rows.length == 0: Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.tab == 0 ? @tr("Nothing is transferring.") : (root.tab == 1 ? @tr("Nothing is waiting.") : (root.tab == 2 ? @tr("Nothing has failed.") : @tr("Nothing has finished yet.")));
                    color: Theme.label2;
                    font-size: Theme.font-caption;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ListView {
                    x: -2px;
                    y: -2px;
                    width: parent.width + 4px;
                    height: parent.height + 4px;
                    accessible-label: root.tab-titles[root.tab];
                    accessible-item-count: root.shown-rows.length;

                    for entry[i] in root.shown-rows: TransferItem {
                        item: entry;
                        tab: root.tab;
                        index: i;
                        count: root.shown-rows.length;
                        chosen: root.tab == 2 && ((i >= root.sel-lo && i <= root.sel-hi) != (entry.selected == root.sel-gen));
                        row-clicked(ctrl, shift) => {
                            root.has-selection = true;
                            if (shift && root.sel-anchor >= 0) {
                                root.sel-gen += 1;
                                root.sel-lo = min(root.sel-anchor, i);
                                root.sel-hi = max(root.sel-anchor, i);
                            } else if (ctrl) {
                                entry.selected = entry.selected == root.sel-gen ? 0 : root.sel-gen;
                                root.sel-anchor = i;
                            } else {
                                root.sel-gen += 1;
                                root.sel-lo = i;
                                root.sel-hi = i;
                                root.sel-anchor = i;
                            }
                        }
                        cancel => { root.cancel(entry.id); }
                        retry => { root.retry(entry.id); }
                        move-to-top => { root.move-to-top(entry.id); }
                        pause => { root.pause-row(entry.id); }
                        resume => { root.resume-row(entry.id); }
                    }
                }
            }
        }
    }
}
