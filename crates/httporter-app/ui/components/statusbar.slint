// Bottom status bar (mockup `.statusbar`): a message on the left, connection details on the right.

import { Theme } from "../theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> left-text;
    in property <string> right-text;

    height: Theme.statusbar-height;
    background: Theme.chrome;

    // Top hairline (mockup: border-top).
    Rectangle {
        y: 0;
        width: parent.width;
        height: 1px;
        background: Theme.sep;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;

        Text {
            text: root.left-text;
            color: Theme.label2;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.right-text;
            color: Theme.label2;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}
