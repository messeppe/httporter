// The Settings window (mockup `Settings.dc.html`): a window of its own with a row of tabs, each
// with its own controls.
//
// Every edit applies at once (the window has no OK button): the window tells its owner through
// `changed()`, and the owner reads the properties back, checks them and shows a message under the
// field it names (`bandwidth-error`, `proxy-error`). Nothing here knows about `TransferSettings`:
// the properties hold the form as the user sees it (see `src/settings_view.rs`).

import { ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Activation, CapsuleButton, ToolButton } from "buttons.slint";
import { ErrorLine, Field, RegionPicker } from "form_controls.slint";
import { Segmented } from "sheets.slint";
import { VCenter } from "layout.slint";
import { ProfileItem, SiteSettingsData, SiteSettingsRow } from "../types.slint";
import { AdvancedTab, GeneralTab, SitesTab } from "settings_tabs.slint";
import { SecurityTab } from "security_tab.slint";
import { CaptionButtons } from "caption_buttons.slint";

// One tab of the row under the title (mockup: a 82 px button with the icon over its name).
// Reachable with Tab, activated with Space or Return. It widens for a name that larger text no
// longer fits in 82 px.
component TabButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    width: max(82px, name.preferred-width + 12px);
    height: 54px + Theme.grow-small;
    border-radius: 8px;
    background: root.selected ? Theme.sel-quiet : (area.has-hover ? Theme.hover : transparent);
    forward-focus: key-focus;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;
        alignment: center;

        Image {
            source: root.icon;
            colorize: root.selected ? Theme.accent-text : Theme.label2;
            height: 20px;
            image-fit: contain;
            accessible-role: none;
        }
        name := Text {
            text: root.text;
            color: Theme.label;
            font-size: Theme.font-small;
            font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    // Keyboard focus ring, 3 px outside like the buttons' ring.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    // Zero width so that clicks do not focus it (the ring is for keyboard focus only).
    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A titled block of rows (mockup `.sb-sec` over a `.group`).
component Section inherits VerticalLayout {
    in property <string> title;

    spacing: 6px;

    HorizontalLayout {
        padding-left: 4px;

        Text {
            text: root.title;
            color: Theme.label2;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
        }
    }
    @children
}

// The rounded box around the rows of a section (mockup `.group`).
component Group inherits Rectangle {
    background: Theme.content;
    border-radius: Theme.radius-md;
    border-width: 0.5px;
    border-color: Theme.sep-strong;

    VerticalLayout {
        @children
    }
}

// One row of a group (mockup `.group-row`): what the setting is called and, in small type under
// it, what it does; its controls at the right. `error` is a red line under the explanation.
component GroupRow inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in property <string> error;
    // The last row of a group has no line under it.
    in property <bool> last: false;

    min-height: 44px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.label;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }
            if root.help != "": Text {
                text: root.help;
                color: Theme.label2;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            if root.error != "": ErrorLine {
                text: root.error;
            }
        }
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 8px;

                @children
            }
        }
    }

    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.sep;
    }
}

// On/off switch (mockup `.switch`: 38 x 22 px). Space toggles it.
component Switch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    out property <bool> has-focus: key-focus.has-focus;
    callback toggled(bool);

    function toggle() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    width: 38px;
    height: 22px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.chip;
    // The off switch is outlined so that it can be seen on the white group (3:1, WCAG 1.4.11).
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.field-border;
    forward-focus: key-focus;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggle(); }

    Rectangle {
        x: root.checked ? 17px : 1px;
        y: 1px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #0000004d;

        animate x { duration: Theme.motion ? 120ms : 0ms; }
    }

    // Keyboard focus ring, 3 px outside.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    // Zero width so that clicks do not focus it (the ring is for keyboard focus only).
    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == Key.Space && !event.repeat && !event.modifiers.alt) {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        clicked => { root.toggle(); }
    }
}

// The Transfers tab: the form, as the user sees it. The properties are the window's own (it binds
// them with `<=>`); the tab only draws them and reports each edit. It is a component of its own
// because the slider and the segmented control write to their own values when the user moves them,
// which would cut them off from the form: `changed` handlers here keep them in step when the
// window, or the other way of changing the value, sets it.
component TransfersTab inherits Rectangle {
    in-out property <int> simultaneous;
    in-out property <bool> adaptive;
    in-out property <int> retries-index;
    in-out property <bool> bandwidth-on;
    in-out property <string> bandwidth-mb;
    in-out property <int> protocol-index;
    in-out property <bool> keep-alive;
    in-out property <int> timeout-index;
    in-out property <int> proxy-index;
    in-out property <string> proxy-url;
    in-out property <bool> verify;
    in-out property <int> upload-conflicts-index;
    in-out property <int> download-conflicts-index;
    in property <string> bandwidth-error;
    in property <string> proxy-error;

    // Something was edited (see the window's `changed`).
    callback edited();
    callback restore-defaults();

    // The options of the drop-downs, in the order the app maps to settings (see `settings_view.rs`).
    property <[string]> retry-options: [@tr("5 times"), @tr("3 times"), @tr("Never")];
    property <[string]> protocol-options: [@tr("HTTP/2 when available"), @tr("HTTP/1.1 only")];
    property <[string]> timeout-options: [@tr("120 seconds"), @tr("60 seconds"), @tr("300 seconds")];
    property <[string]> proxy-options: [@tr("Use Windows settings"), @tr("No proxy"), @tr("Custom…")];
    property <[string]> upload-options: [@tr("Uploads: Ask once per batch"), @tr("Uploads: Replace if different"), @tr("Uploads: Skip"), @tr("Uploads: Replace all"), @tr("Uploads: Keep both")];
    property <[string]> download-options: [@tr("Downloads: Ask once per batch"), @tr("Downloads: Replace if different"), @tr("Downloads: Keep both"), @tr("Downloads: Replace all"), @tr("Downloads: Skip")];

    changed simultaneous => { slider.value = root.simultaneous; }
    changed bandwidth-on => { bandwidth-mode.current = root.bandwidth-on ? 1 : 0; }

    // Moves the number of simultaneous transfers within 1 to 128 and reports it.
    function set-simultaneous(value: int) {
        if (value >= 1 && value <= 128 && value != root.simultaneous) {
            root.simultaneous = value;
            root.edited();
        }
    }

    ScrollView {
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 22px;
            spacing: 18px;

            Section {
                title: @tr("Speed");

                Group {
                    GroupRow {
                        title: @tr("Simultaneous transfers");
                        help: @tr("Per site. Bunny Storage allows up to 96 from one computer; S3 services up to 128.");

                        slider := Slider {
                            width: 150px;
                            minimum: 1;
                            maximum: 128;
                            step: 1;
                            value: root.simultaneous;
                            accessible-label: @tr("Simultaneous transfers");
                            changed(value) => { root.set-simultaneous(Math.round(value)); }
                        }
                        // Fewer, the number, More (mockup `.tgroup`).
                        HorizontalLayout {
                            spacing: 2px;

                            VCenter {
                                ToolButton {
                                    icon: Icons.minus;
                                    label: @tr("Fewer");
                                    enabled: root.simultaneous > 1;
                                    clicked => { root.set-simultaneous(root.simultaneous - 1); }
                                }
                            }
                            Text {
                                min-width: 34px;
                                text: root.simultaneous;
                                color: Theme.label;
                                font-size: Theme.font-body;
                                font-weight: Theme.weight-semibold;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            VCenter {
                                ToolButton {
                                    icon: Icons.plus;
                                    label: @tr("More");
                                    enabled: root.simultaneous < 128;
                                    clicked => { root.set-simultaneous(root.simultaneous + 1); }
                                }
                            }
                        }
                    }
                    GroupRow {
                        title: @tr("Slow down when a server asks");
                        help: @tr("On HTTP 429 or 503, halve parallel transfers, then ramp back up.");

                        Switch {
                            label: @tr("Slow down when a server asks");
                            checked <=> root.adaptive;
                            toggled => { root.edited(); }
                        }
                    }
                    GroupRow {
                        title: @tr("Retry failed transfers");
                        help: @tr("Waits 1, 2, 4, 8 and 10 seconds between attempts.");

                        RegionPicker {
                            width: 140px;
                            model: root.retry-options;
                            label: @tr("Retries");
                            current-index <=> root.retries-index;
                            selected => { root.edited(); }
                        }
                    }
                    GroupRow {
                        title: @tr("Bandwidth limit");
                        help: @tr("Applies to all transfers together.");
                        error: root.bandwidth-error;
                        last: true;

                        bandwidth-mode := Segmented {
                            options: [@tr("Off"), @tr("Limit to")];
                            label: @tr("Bandwidth limit");
                            current: root.bandwidth-on ? 1 : 0;
                            selected(index) => {
                                root.bandwidth-on = index == 1;
                                root.edited();
                            }
                        }
                        VCenter {
                            Field {
                                width: 90px;
                                text <=> root.bandwidth-mb;
                                enabled: root.bandwidth-on;
                                label: @tr("Limit");
                                error: root.bandwidth-error;
                                edited => { root.edited(); }
                            }
                        }
                        VCenter {
                            Text {
                                text: @tr("MB/s");
                                color: root.bandwidth-on ? Theme.label : Theme.label3;
                                font-size: Theme.font-body;
                            }
                        }
                    }
                }
            }

            Section {
                title: @tr("HTTP connection");

                Group {
                    GroupRow {
                        title: @tr("Protocol");
                        help: @tr("Every connection is encrypted with TLS 1.2 or newer.");

                        RegionPicker {
                            width: 200px;
                            model: root.protocol-options;
                            label: @tr("HTTP version");
                            current-index <=> root.protocol-index;
                            selected => { root.edited(); }
                        }
                    }
                    GroupRow {
                        title: @tr("Keep connections open between files");
                        help: @tr("Saves a TLS handshake per file. Strongly recommended.");

                        Switch {
                            label: @tr("Keep connections open");
                            checked <=> root.keep-alive;
                            toggled => { root.edited(); }
                        }
                    }
                    GroupRow {
                        title: @tr("Request timeout");

                        RegionPicker {
                            width: 140px;
                            model: root.timeout-options;
                            label: @tr("Request timeout");
                            current-index <=> root.timeout-index;
                            selected => { root.edited(); }
                        }
                    }
                    GroupRow {
                        title: @tr("Proxy");
                        error: root.proxy-error;
                        last: true;

                        VerticalLayout {
                            spacing: 6px;

                            RegionPicker {
                                width: 200px;
                                open-up: true;
                                model: root.proxy-options;
                                label: @tr("Proxy");
                                current-index <=> root.proxy-index;
                                selected => { root.edited(); }
                            }
                            // The address of a custom proxy. It is applied when finished (Return,
                            // or leaving the field), not as it is typed: a password typed into it
                            // must never be saved half way.
                            if root.proxy-index == 2: Field {
                                width: 200px;
                                text <=> root.proxy-url;
                                placeholder: @tr("http://proxy:8080");
                                label: @tr("Proxy address");
                                error: root.proxy-error;
                                accepted => { root.edited(); }
                                changed has-focus => {
                                    if (!self.has-focus) {
                                        root.edited();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Section {
                title: @tr("Integrity and conflicts");

                Group {
                    GroupRow {
                        title: @tr("Verify every upload with a checksum");
                        help: @tr("SHA-256 on Bunny Storage, MD5 on S3-compatible services. The server rejects damaged files.");

                        Switch {
                            label: @tr("Verify uploads");
                            checked <=> root.verify;
                            toggled => { root.edited(); }
                        }
                    }
                    GroupRow {
                        title: @tr("When a file already exists");
                        help: @tr("One choice per batch, never one dialog per file.");
                        last: true;

                        VerticalLayout {
                            spacing: 6px;

                            RegionPicker {
                                width: 230px;
                                open-up: true;
                                model: root.upload-options;
                                label: @tr("When uploading");
                                current-index <=> root.upload-conflicts-index;
                                selected => { root.edited(); }
                            }
                            RegionPicker {
                                width: 230px;
                                open-up: true;
                                model: root.download-options;
                                label: @tr("When downloading");
                                current-index <=> root.download-conflicts-index;
                                selected => { root.edited(); }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;

                CapsuleButton {
                    text: @tr("Restore Defaults");
                    clicked => { root.restore-defaults(); }
                }
            }
        }
    }
}

// The Publish tab: the Bunny account keys kept for purging the CDN, each with Forget Key. A key
// is `name` (the account) over `meta` (a line about it); `id` is what `forget-key` hands back.
component PublishTab inherits Rectangle {
    in property <[ProfileItem]> keys;
    // What went wrong forgetting a key, empty for nothing.
    in property <string> error;
    callback forget-key(string);

    ScrollView {
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 22px;
            spacing: 18px;
            alignment: start;

            Section {
                title: @tr("Bunny account keys");

                Group {
                    for key[index] in root.keys: GroupRow {
                        title: key.name;
                        help: key.meta;
                        last: index == root.keys.length - 1;

                        CapsuleButton {
                            text: @tr("Forget Key");
                            clicked => { root.forget-key(key.id); }
                        }
                    }
                    if root.keys.length == 0: GroupRow {
                        title: @tr("No account keys kept");
                        help: @tr("Publish asks for your Bunny account key the first time it purges the CDN.");
                        last: true;
                    }
                }
            }
            if root.error != "": ErrorLine {
                text: root.error;
            }
            Text {
                text: @tr("An account key lets HTTPorter clear the CDN's copies of what a publish changed. It is kept in Windows Credential Manager. Forget Key deletes it there, and turns purging off until the key is added again.");
                color: Theme.label2;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}

export component SettingsWindow inherits Window {
    // The tabs, in order.
    property <[string]> tab-names: [@tr("General"), @tr("Sites"), @tr("Transfers"), @tr("Security"), @tr("Publish"), @tr("Advanced")];
    property <[image]> tab-icons: [Icons.gear, Icons.globe, Icons.updown, Icons.lock, Icons.send, Icons.chip];

    // The tab shown. The window title is its name.
    in-out property <int> current-tab: 2;

    // The Transfers form, as the user sees it. The app sets these when it opens the window and
    // when Restore Defaults has been pressed; they change as the user edits. Retries, protocol,
    // timeout and proxy are positions in their drop-down; the conflict choices are positions in
    // the upload and download lists, which are in different orders.
    in-out property <int> simultaneous: 32;
    in-out property <bool> adaptive: true;
    in-out property <int> retries-index: 0;
    in-out property <bool> bandwidth-on: false;
    in-out property <string> bandwidth-mb: "10";
    in-out property <int> protocol-index: 0;
    in-out property <bool> keep-alive: true;
    in-out property <int> timeout-index: 0;
    in-out property <int> proxy-index: 0;
    in-out property <string> proxy-url;
    in-out property <bool> verify: true;
    in-out property <int> upload-conflicts-index: 0;
    in-out property <int> download-conflicts-index: 0;
    // What is wrong with the bandwidth limit or the proxy address, empty for nothing. Set by the
    // app after it checks the form.
    in-out property <string> bandwidth-error;
    in-out property <string> proxy-error;

    // Something in the form was edited (every edit applies at once, the window has no OK button).
    // A text field reports its edit as it is typed, except the proxy address, which is reported
    // when it is finished (Return, or leaving the field): a half-typed address must not be applied.
    callback changed();
    callback restore-defaults();

    // The Publish tab: the Bunny account keys kept for purging (see `PublishTab`), and what went
    // wrong forgetting one. `publish-shown` asks the app for the keys whenever the tab is opened.
    in property <[ProfileItem]> bunny-keys;
    in property <string> bunny-keys-error;
    callback forget-key(string);
    callback publish-shown();

    // ---- I4 (T8): General (0), Sites (1) and Advanced (5) ----
    // General.
    in-out property <int> appearance: 0;
    in-out property <int> start-view: 0;
    in-out property <bool> restore-tabs: true;
    in-out property <bool> ask-big-preview: true;
    in property <string> preview-cache-text;
    callback clear-preview-cache();
    callback general-edited();
    // Sites.
    in property <[SiteSettingsRow]> site-rows;
    in-out property <int> site-current: -1;
    in-out property <SiteSettingsData> site-form;
    // A site row was chosen: the app fills `site-form`.
    callback site-chosen(int);
    callback site-form-save(SiteSettingsData);
    // Forget the remembered choice for uploads (true) or downloads.
    callback site-forget-choice(bool);
    callback export-sites();
    callback import-sites();
    in property <string> sites-message;
    // Advanced.
    in property <string> hash-cache-text;
    callback clear-hash-cache();
    callback show-activity();
    callback open-log-folder();
    // The renderer (I5, see `AdvancedTab`).
    in-out property <int> renderer: 0;
    in property <bool> renderer-fell-back: false;
    callback renderer-edited();
    // A tab was opened (its number), for the app to refresh what it shows.
    callback tab-shown(int);

    // ---- I5 ----
    // The title bar is the window's caption (T2): Close only. A press on its empty part drags the
    // window, a right-click opens the system menu (at that point, in window coordinates). Its
    // title dims while the window is not the active one.
    in property <bool> settings-window-active: true;
    callback settings-caption-close();
    callback settings-caption-drag();
    callback settings-caption-menu(length, length);
    // General (T4): the tray, the update check and About (see `GeneralTab`).
    in-out property <bool> tray: true;
    in-out property <bool> check-updates: false;
    in property <bool> updates-available: false;
    in property <string> updates-note;
    callback check-now();
    in property <string> app-version;
    in property <bool> licenses-available: false;
    callback open-licenses();
    // Security (T4, see `SecurityTab`).
    in property <int> site-keys;
    in property <int> account-keys;
    in property <int> unused-keys;
    in property <string> security-message;
    in property <bool> reset-allowed;
    in property <string> reset-note;
    callback remove-unused-keys();
    callback open-credential-manager();
    callback reset-requested();
    callback reset-confirmed();

    changed current-tab => {
        if (root.current-tab == 4) {
            root.publish-shown();
        }
        root.tab-shown(root.current-tab);
    }

    title: root.tab-names[root.current-tab];
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;
    background: Theme.win;
    preferred-width: 760px;
    preferred-height: 720px;
    min-width: 620px;
    min-height: 420px;

    VerticalLayout {
        // The title bar (mockup `Settings.dc.html`, I5 T2): a 32 px row with the open tab's name
        // centred and Close at its right end, over the row of tabs. Its empty parts are the
        // window's caption: a press drags the window, a right-click opens the system menu. The
        // tab buttons keep their own presses.
        Rectangle {
            background: Theme.chrome;
            height: 98px + Theme.grow + Theme.grow-small;

            caption-area := TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        root.settings-caption-drag();
                    } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                        root.settings-caption-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }

            VerticalLayout {
                // As much padding at the left as Close is wide: the title is centred in the window.
                HorizontalLayout {
                    height: 32px + Theme.grow;
                    padding-left: 46px;
                    padding-right: 46px;

                    Text {
                        text: root.tab-names[root.current-tab];
                        color: root.settings-window-active ? Theme.label : Theme.label2;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle {
                    height: 66px + Theme.grow-small;
                    accessible-role: tab-list;
                    accessible-label: @tr("Settings sections");

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 2px;
                        padding-bottom: 10px;
                        spacing: 4px;
                        alignment: center;

                        for name[index] in root.tab-names: TabButton {
                            text: name;
                            icon: root.tab-icons[index];
                            selected: index == root.current-tab;
                            clicked => { root.current-tab = index; }
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.sep;
            }

            CaptionButtons {
                x: parent.width - self.width;
                y: 0px;
                height: 32px;
                close-only: true;
                active: root.settings-window-active;
                close => { root.settings-caption-close(); }
            }
        }

        if root.current-tab == 3: SecurityTab {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: root.tab-names[3];
            site-keys: root.site-keys;
            account-keys: root.account-keys;
            unused-keys: root.unused-keys;
            security-message: root.security-message;
            reset-allowed: root.reset-allowed;
            reset-note: root.reset-note;
            remove-unused-keys => { root.remove-unused-keys(); }
            open-credential-manager => { root.open-credential-manager(); }
            reset-requested => { root.reset-requested(); }
            reset-confirmed => { root.reset-confirmed(); }
        }

        if root.current-tab == 2: TransfersTab {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: root.tab-names[2];
            simultaneous <=> root.simultaneous;
            adaptive <=> root.adaptive;
            retries-index <=> root.retries-index;
            bandwidth-on <=> root.bandwidth-on;
            bandwidth-mb <=> root.bandwidth-mb;
            protocol-index <=> root.protocol-index;
            keep-alive <=> root.keep-alive;
            timeout-index <=> root.timeout-index;
            proxy-index <=> root.proxy-index;
            proxy-url <=> root.proxy-url;
            verify <=> root.verify;
            upload-conflicts-index <=> root.upload-conflicts-index;
            download-conflicts-index <=> root.download-conflicts-index;
            bandwidth-error: root.bandwidth-error;
            proxy-error: root.proxy-error;
            edited => { root.changed(); }
            restore-defaults => { root.restore-defaults(); }
        }

        if root.current-tab == 0: GeneralTab {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: root.tab-names[0];
            appearance <=> root.appearance;
            start-view <=> root.start-view;
            restore-tabs <=> root.restore-tabs;
            ask-big-preview <=> root.ask-big-preview;
            preview-cache-text: root.preview-cache-text;
            clear-preview-cache => { root.clear-preview-cache(); }
            edited => { root.general-edited(); }
            tray <=> root.tray;
            check-updates <=> root.check-updates;
            updates-available: root.updates-available;
            updates-note: root.updates-note;
            check-now => { root.check-now(); }
            app-version: root.app-version;
            licenses-available: root.licenses-available;
            open-licenses => { root.open-licenses(); }
        }

        if root.current-tab == 1: SitesTab {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: root.tab-names[1];
            rows: root.site-rows;
            current <=> root.site-current;
            form <=> root.site-form;
            message: root.sites-message;
            chosen(index) => { root.site-chosen(index); }
            save(form) => { root.site-form-save(form); }
            forget-choice(upload) => { root.site-forget-choice(upload); }
            export-sites => { root.export-sites(); }
            import-sites => { root.import-sites(); }
        }

        if root.current-tab == 5: AdvancedTab {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: root.tab-names[5];
            hash-cache-text: root.hash-cache-text;
            clear-hash-cache => { root.clear-hash-cache(); }
            show-activity => { root.show-activity(); }
            open-log-folder => { root.open-log-folder(); }
            renderer <=> root.renderer;
            renderer-fell-back: root.renderer-fell-back;
            renderer-edited => { root.renderer-edited(); }
        }

        if root.current-tab == 4: PublishTab {
            vertical-stretch: 1;
            accessible-role: tab-panel;
            accessible-label: root.tab-names[4];
            keys: root.bunny-keys;
            error: root.bunny-keys-error;
            forget-key(id) => { root.forget-key(id); }
        }
    }
}
