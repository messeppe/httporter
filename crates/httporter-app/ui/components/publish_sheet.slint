// The Publish sheet (mockup `Main.dc.html` l.277–333), Review Deletions and the CDN key sheet.
// Each is placed in app.slint, which shows it while its open flag is set. Like the other sheets
// they only show what the app tells them and say what was pressed; they hang from the toolbar, keep
// the keyboard inside, and Escape cancels.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { PlanGroup, PlanRow, PublishSheetData } from "../types.slint";
import { CapsuleButton } from "buttons.slint";
import { Chip } from "chips.slint";
import { KindStyle } from "drawer.slint";
import { CheckLine, ErrorLine, Field, FormRow, SecretField } from "form_controls.slint";
import { VCenter } from "layout.slint";
import { AttachedSheet, Modal, Segmented } from "sheets.slint";

// Counts with thousands separators, as the app writes them ("13,756").
global Counts {
    pure public function three(n: int) -> string {
        return n < 10 ? "00" + n : (n < 100 ? "0" + n : "" + n);
    }
    pure public function grouped(n: int) -> string {
        return n < 1000 ? "" + n : (n < 1000000 ? Math.floor(n / 1000) + "," + Counts.three(Math.mod(n, 1000)) : Math.floor(n / 1000000) + "," + Counts.three(Math.mod(Math.floor(n / 1000), 1000)) + "," + Counts.three(Math.mod(n, 1000)));
    }
}

// The height of a plan list row, which holds a line of text.
global PlanSizes {
    out property <length> row: 30px + Theme.grow;
}

// The tint of each group's chip (mockup `.chip.changed`, `.new`, `.remote`, and red for a delete).
global GroupStyle {
    pure public function fg(group: PlanGroup) -> color {
        return group == PlanGroup.changed ? Theme.orange : group == PlanGroup.new ? Theme.green : group == PlanGroup.kept ? Theme.purple : Theme.red;
    }
    pure public function bg(group: PlanGroup) -> color {
        return group == PlanGroup.changed ? Theme.orange-soft : group == PlanGroup.new ? Theme.green-soft : group == PlanGroup.kept ? Theme.purple-soft : Theme.red-soft;
    }
}

// The tile at the head of a sheet (mockup `.appicon`): the app's blue, or a tinted one.
component SheetIcon inherits Rectangle {
    in property <image> icon;
    // Tinted tile (for a destructive sheet) instead of the app's blue.
    in property <color> tint: transparent;
    in property <color> tint-soft: transparent;

    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: root.tint == transparent ? @linear-gradient(160deg, Theme.app-icon-top 0%, Theme.app-icon-bottom 100%) : root.tint-soft;

    Image {
        source: root.icon;
        colorize: root.tint == transparent ? Theme.on-accent : root.tint;
        width: 26px;
        height: 26px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        accessible-role: none;
    }
}

// The head of a sheet: its tile, title and what it is for.
component SheetHead inherits HorizontalLayout {
    in property <image> icon;
    in property <color> tint: transparent;
    in property <color> tint-soft: transparent;
    in property <string> title;
    in property <string> body;

    padding-left: 22px;
    padding-right: 22px;
    padding-top: 20px;
    padding-bottom: 12px;
    spacing: 14px;

    VerticalLayout {
        alignment: start;
        SheetIcon {
            icon: root.icon;
            tint: root.tint;
            tint-soft: root.tint-soft;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;

        Text {
            text: root.title;
            color: Theme.label;
            font-size: Theme.font-headline;
            font-weight: Theme.weight-semibold;
            wrap: word-wrap;
        }
        Text {
            text: root.body;
            color: Theme.label2;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
    }
}

// The footer's separator line.
component FootRule inherits Rectangle {
    height: 1px;
    background: Theme.sep;
}

// A 14 px checkbox mark (mockup `input[type=checkbox]`), drawn only: its row takes the clicks.
component Tick inherits Rectangle {
    in property <bool> checked;

    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: root.checked ? Theme.accent : Theme.field;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.field-border;

    Image {
        source: Icons.check;
        colorize: Theme.on-accent;
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        visible: root.checked;
        accessible-role: none;
    }
}

// One row of the plan list (mockup: checkbox, kind icon and path, the chip, the size), or a group
// header with its group's checkbox, title, file count and size. A click anywhere on it toggles it.
// The keyboard reaches it through the list (PlanList), which says when it is on the row.
component PlanItem inherits Rectangle {
    in property <PlanRow> entry;
    // Where the row is in the list, for assistive technology.
    in property <int> index;
    in property <int> count;
    // The keyboard is on this row and the list has the focus: the focus ring shows.
    in property <bool> focused;
    callback toggled();
    // A tree folder row's disclosure triangle.
    callback expand();

    height: PlanSizes.row;
    background: root.entry.header ? Theme.row-alt : (area.has-hover ? Theme.hover : transparent);
    accessible-role: checkbox;
    // The path and what happens to it ("index.html, Changed"; the state, "checked", is read
    // after it); a group header's title and count ("Changed, 12 files"), a tree folder's name
    // and count.
    accessible-label: @tr("{}, {}", root.entry.path, root.entry.label);
    accessible-description: root.entry.size;
    accessible-checkable: true;
    accessible-checked: root.entry.checked;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-expandable: root.entry.folder;
    accessible-expanded: root.entry.folder && root.entry.expanded;
    accessible-action-default => { root.toggled(); }
    accessible-action-expand => {
        if (root.entry.folder && !root.entry.expanded) {
            root.expand();
        }
    }

    area := TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 14px + root.entry.depth * 16px;
        padding-right: 14px;
        spacing: 8px;

        VCenter { Tick { checked: root.entry.checked; } }
        // The tree's disclosure triangle (a folder row), or the room it takes (a file row in the
        // tree), so that names line up.
        if root.entry.folder: VCenter {
            Rectangle {
                width: 14px;
                height: 14px;
                accessible-role: button;
                accessible-label: root.entry.expanded ? @tr("Collapse {}", root.entry.path) : @tr("Expand {}", root.entry.path);
                accessible-action-default => { root.expand(); }

                Image {
                    source: root.entry.expanded ? Icons.chev-d : Icons.chev-r;
                    colorize: Theme.label2;
                    width: 10px;
                    height: 10px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    accessible-role: none;
                }
                TouchArea {
                    clicked => { root.expand(); }
                }
            }
        }
        if !root.entry.header: VCenter {
            Image {
                source: KindStyle.icon(root.entry.kind);
                colorize: KindStyle.tint(root.entry.kind);
                width: 14px;
                height: 14px;
                accessible-role: none;
            }
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.entry.path;
            color: Theme.label;
            font-size: root.entry.header ? Theme.font-small : Theme.font-body;
            font-weight: root.entry.header ? Theme.weight-semibold : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Rectangle {
            width: 120px;

            if root.entry.header: Text {
                width: parent.width;
                height: parent.height;
                text: root.entry.label;
                color: Theme.label2;
                font-size: Theme.font-small;
                vertical-alignment: center;
                accessible-role: none;
            }
            if !root.entry.header: HorizontalLayout {
                alignment: start;

                VCenter {
                    Chip {
                        text: root.entry.label;
                        fg: GroupStyle.fg(root.entry.group);
                        bg: GroupStyle.bg(root.entry.group);
                    }
                }
            }
        }
        Text {
            width: 90px;
            text: root.entry.size;
            color: Theme.label2;
            font-size: Theme.font-caption;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    // The line under a group header.
    if root.entry.header: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.sep;
    }

    // Focus ring inside the row, clear of the list's rounded corners: the list clips one drawn
    // outside.
    Rectangle {
        x: 3px;
        y: 2px;
        width: parent.width - 6px;
        height: parent.height - 4px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.focused;
    }
}

// The plan list. One Tab stop, like the site list (ledger 155), but the keys are the list's own
// (the rows are virtualized, so the focus can't live in a row that scrolls away): Up and Down,
// Home and End, PageUp and PageDown move the keyboard's row, which is scrolled into view and drawn
// with the focus ring; Space ticks or clears its checkbox (a group header's or a tree folder's for
// all it holds), as a click does; in the tree, Right opens a closed folder and Left closes an open
// one. Return is left to the sheet's default button and Escape to Cancel. Assistive technology is
// told the keyboard's row is the one focused (`accessible-delegate-focus`).
component PlanList inherits Rectangle {
    in property <[PlanRow]> rows;
    // A row's checkbox, as a click on it; a tree folder opened or closed.
    callback toggle(int);
    callback expand(int);

    // The row the keyboard is on: the last one moved to or clicked, kept inside the rows when
    // they change (a filter, a folder closed).
    property <int> key-row: 0;
    property <int> at: Math.max(0, Math.min(root.rows.length - 1, root.key-row));
    // The rows a PageUp or PageDown moves by: a view of them, less one.
    property <int> page: Math.max(1, Math.floor(view.visible-height / PlanSizes.row) - 1);

    accessible-role: list;
    accessible-label: @tr("Files to publish");
    accessible-item-count: root.rows.length;
    // The list view only makes the rows in view; the focus goes to the keyboard's row among those,
    // the first of which is the one at the top of the view (half a pixel of slack for the list
    // lining a row up with the top).
    accessible-delegate-focus: root.at - Math.floor((-view.content-y + 0.5px) / PlanSizes.row);

    // Scroll so that the keyboard's row is fully in view (as the panes do). Does nothing before
    // the list has been laid out.
    function reveal() {
        if (view.visible-height <= 0px) {
            return;
        }
        if (root.at * PlanSizes.row < -view.content-y) {
            view.content-y = -root.at * PlanSizes.row;
        } else if ((root.at + 1) * PlanSizes.row > -view.content-y + view.visible-height) {
            if ((root.at + 1) * PlanSizes.row > -view.content-y + 1.5 * view.visible-height) {
                // A long way down: the list snaps a jump of more than a screen and a half to a
                // whole row, so line the row up with the top of the list, where that is exact.
                view.content-y = -root.at * PlanSizes.row;
            } else {
                view.content-y = view.visible-height - (root.at + 1) * PlanSizes.row;
            }
        }
    }

    function move-to(index: int) {
        if (root.rows.length > 0) {
            root.key-row = Math.max(0, Math.min(root.rows.length - 1, index));
            root.reveal();
        }
    }

    // Tab came to the list: the keyboard stays on its row if that is in view, else it takes the
    // first row in view (the list may have been scrolled with the mouse).
    function take-row-in-view() {
        if (view.visible-height <= 0px) {
            return;
        }
        let first = Math.ceil(-view.content-y / PlanSizes.row);
        let last = Math.floor((-view.content-y + view.visible-height) / PlanSizes.row) - 1;
        if (last >= first && (root.at < first || root.at > last)) {
            root.key-row = Math.max(0, Math.min(root.rows.length - 1, first));
        }
    }

    // Zero width so that clicks do not focus it: a click on a row only toggles it.
    keys := FocusScope {
        x: 0;
        width: 0;
        focus-gained(reason) => { root.take-row-in-view(); }
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                root.move-to(root.at - 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-to(root.at + 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.move-to(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.move-to(root.rows.length - 1);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.move-to(root.at - root.page);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.move-to(root.at + root.page);
                return accept;
            }
            if (event.text == Key.Space) {
                if (!event.repeat) {
                    root.reveal();
                    root.toggle(root.at);
                }
                return accept;
            }
            if (event.text == Key.RightArrow && root.rows[root.at].folder && !root.rows[root.at].expanded) {
                root.expand(root.at);
                return accept;
            }
            if (event.text == Key.LeftArrow && root.rows[root.at].folder && root.rows[root.at].expanded) {
                root.expand(root.at);
                return accept;
            }
            return reject;
        }
    }

    // The list view insets its content by 2 px on every side; it reaches out by that much so
    // that the rows run edge to edge. Not an element of its own for assistive technology: this
    // list is, so that the focus can be handed to a row.
    view := ListView {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        accessible-role: none;

        for row[i] in root.rows: PlanItem {
            entry: row;
            index: i;
            count: root.rows.length;
            focused: keys.has-focus && i == root.at;
            toggled => {
                root.key-row = i;
                root.toggle(i);
            }
            expand => {
                root.key-row = i;
                root.expand(i);
            }
        }
    }
}

export component PublishSheet inherits Rectangle {
    in property <PublishSheetData> data;
    in property <[PlanRow]> rows;
    // A plan row's checkbox (a group header's toggles its group).
    callback toggle(int);
    callback remove-extras(bool);
    // 0 off, 1 changed files, 2 whole zone.
    callback purge(int);
    callback change-folder();
    callback export-plan();
    callback cancelled();
    // "Publish N Files", or "Review Deletions…" when `data.needs-review`.
    callback confirmed();
    // ---- I4 (T9) ----
    // Flat (0) or Tree (1); the filter as typed; a tree folder row (index into `rows`) opened or
    // closed.
    callback plan-view(int);
    callback plan-filter-changed(string);
    callback plan-expand(int);

    // As many rows as fit under the toolbar with the rest of the sheet (about 460 px, and its dozen
    // lines of text grow with the text size), and at least four.
    property <length> list-height: min(max(root.rows.length, 4) * PlanSizes.row, max(4 * PlanSizes.row, root.height - Theme.toolbar-height - 460px - 12 * Theme.grow));
    property <bool> busy: root.data.busy;
    property <bool> has-plan: !root.data.busy && root.data.error == "";

    // The comparing ended: the publish button takes the focus when there is something to publish.
    changed busy => {
        if (!root.busy && root.data.can-publish) {
            publish-button.focus();
        }
    }
    changed data => { purge-control.current = root.data.purge; }

    init => {
        purge-control.current = root.data.purge;
        cancel-button.focus();
    }

    Modal {
        at-first-stop: root.busy ? cancel-button.has-focus : change-button.has-focus;
        at-last-stop: root.data.can-publish ? publish-button.has-focus : cancel-button.has-focus;
        cancel => { root.cancelled(); }
        confirm => {
            if (root.data.can-publish) {
                root.confirmed();
            }
        }
        focus-first => {
            if (root.busy) {
                cancel-button.focus();
            } else {
                change-button.focus();
            }
        }
        focus-last => {
            if (root.data.can-publish) {
                publish-button.focus();
            } else {
                cancel-button.focus();
            }
        }

        AttachedSheet {
            sheet-width: 760px;
            label: root.data.title;

            SheetHead {
                icon: Icons.send;
                title: root.data.title;
                body: root.data.subtitle;
            }

            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-bottom: 14px;
                spacing: 12px;

                // The folder and where it goes (mockup `.group`).
                Rectangle {
                    background: Theme.content;
                    border-radius: Theme.radius-md;
                    border-width: 0.5px;
                    border-color: Theme.sep-strong;

                    VerticalLayout {
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 12px;
                            min-height: 44px;

                            VCenter {
                                Image {
                                    source: Icons.folder;
                                    colorize: Theme.label2;
                                    width: 16px;
                                    height: 16px;
                                    accessible-role: none;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.data.folder;
                                    color: Theme.label;
                                    font-size: Theme.font-body;
                                    overflow: elide;
                                }
                                Text {
                                    text: @tr("Folder on this PC");
                                    color: Theme.label2;
                                    font-size: Theme.font-small;
                                }
                            }
                            VCenter {
                                change-button := CapsuleButton {
                                    text: @tr("Change Folder…");
                                    enabled: !root.busy;
                                    clicked => { root.change-folder(); }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.sep;
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 12px;
                            min-height: 44px;

                            VCenter {
                                Image {
                                    source: Icons.lock;
                                    colorize: Theme.green;
                                    width: 16px;
                                    height: 16px;
                                    accessible-role: none;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.data.destination;
                                    color: Theme.label;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-caption;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.data.destination-note;
                                    color: Theme.label2;
                                    font-size: Theme.font-small;
                                }
                            }
                        }
                    }
                }

                // What the compare found, and what will go up.
                HorizontalLayout {
                    spacing: 8px;
                    height: Theme.chip-height;

                    if root.has-plan && root.data.changed > 0: Chip {
                        text: @tr("{} changed", Counts.grouped(root.data.changed));
                        fg: Theme.orange;
                        bg: Theme.orange-soft;
                    }
                    if root.has-plan && root.data.new > 0: Chip {
                        text: @tr("{} new", Counts.grouped(root.data.new));
                        fg: Theme.green;
                        bg: Theme.green-soft;
                    }
                    if root.has-plan && root.data.remote-only > 0: Chip {
                        text: @tr("{} {}", Counts.grouped(root.data.remote-only), root.data.remote-label);
                        fg: Theme.purple;
                        bg: Theme.purple-soft;
                    }
                    if root.has-plan && root.data.same > 0: Chip {
                        text: @tr("{} same", Counts.grouped(root.data.same));
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.data.upload-text;
                        color: Theme.label2;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }

                // Flat or Tree, and the filter (I4).
                if root.has-plan: HorizontalLayout {
                    spacing: 12px;

                    VCenter {
                        Segmented {
                            options: [@tr("Flat"), @tr("Tree")];
                            label: @tr("Show the files as a list or as folders");
                            selected(index) => { root.plan-view(index); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    filter-field := Field {
                        width: 240px;
                        label: @tr("Filter the files");
                        placeholder: @tr("Filter by path");
                        edited => { root.plan-filter-changed(self.text); }
                    }
                }

                // The plan list; while comparing, how far it is; or what went wrong.
                Rectangle {
                    height: root.list-height;
                    background: Theme.content;
                    border-radius: Theme.radius-md;
                    border-width: 0.5px;
                    border-color: Theme.sep-strong;
                    clip: true;

                    if root.busy: Text {
                        width: parent.width - 32px;
                        text: root.data.progress;
                        color: Theme.label2;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    if !root.busy && root.data.error != "": VerticalLayout {
                        padding: 16px;
                        alignment: center;

                        ErrorLine { text: root.data.error; }
                    }
                    if root.has-plan && root.rows.length == 0: Text {
                        width: parent.width - 32px;
                        text: @tr("The folder and the site match: there is nothing to upload or delete.");
                        color: Theme.label2;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.has-plan && root.rows.length > 0: PlanList {
                        width: parent.width;
                        height: parent.height;
                        rows: root.rows;
                        toggle(i) => { root.toggle(i); }
                        expand(i) => { root.plan-expand(i); }
                    }
                }

                // Remove extras, and the CDN purge.
                HorizontalLayout {
                    spacing: 12px;

                    VCenter {
                        CheckLine {
                            horizontal-stretch: 1;
                            text: root.data.remove-label;
                            checked: root.data.remove-extras;
                            enabled: root.has-plan && root.data.remote-only > 0;
                            toggled(on) => { root.remove-extras(on); }
                        }
                    }
                    VCenter {
                        Text {
                            text: @tr("Purge CDN:");
                            color: Theme.label2;
                            font-size: Theme.font-body;
                            opacity: root.data.purge-enabled ? 1 : 0.45;
                        }
                    }
                    VCenter {
                        // Turned off (an S3 site), it is dimmed and skipped by Tab.
                        purge-control := Segmented {
                            options: [@tr("Off"), @tr("Changed files"), @tr("Whole zone")];
                            label: @tr("Purge CDN after publishing");
                            enabled: root.data.purge-enabled;
                            selected(index) => { root.purge(index); }
                        }
                    }
                }
                if root.data.purge-note != "": Text {
                    text: root.data.purge-note;
                    color: Theme.label2;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                    wrap: word-wrap;
                }
                if root.data.warning != "": HorizontalLayout {
                    spacing: 6px;

                    VCenter {
                        Image {
                            source: Icons.warn;
                            colorize: Theme.orange;
                            width: 14px;
                            height: 14px;
                            accessible-role: none;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.data.warning;
                        color: Theme.orange;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }
            }

            FootRule { }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 8px;

                CapsuleButton {
                    text: @tr("Export Plan…");
                    enabled: root.has-plan && root.rows.length > 0;
                    clicked => { root.export-plan(); }
                }
                Rectangle { horizontal-stretch: 1; }
                cancel-button := CapsuleButton {
                    text: @tr("Cancel");
                    clicked => { root.cancelled(); }
                }
                publish-button := CapsuleButton {
                    text: root.data.button-label;
                    icon: Icons.send;
                    primary: true;
                    enabled: root.data.can-publish;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}

// Asks for the zone or bucket name (`data.review-name`) before a publish deletes more files than
// the profile's delete guard allows. The delete button stays off until the name is typed exactly,
// and is never the default.
export component ReviewDeletionsSheet inherits Rectangle {
    in property <PublishSheetData> data;
    in property <[PlanRow]> rows;
    // The name as typed.
    callback confirmed(string);
    callback cancelled();

    property <bool> matches: name-field.text == root.data.review-name;

    init => { name-field.focus(); }

    Modal {
        at-first-stop: name-field.has-focus;
        at-last-stop: root.matches ? delete-button.has-focus : cancel-button.has-focus;
        cancel => { root.cancelled(); }
        // Return deletes nothing: the delete button has to be pressed.
        confirm => { }
        focus-first => { name-field.focus(); }
        focus-last => {
            if (root.matches) {
                delete-button.focus();
            } else {
                cancel-button.focus();
            }
        }

        AttachedSheet {
            sheet-width: 500px;
            label: @tr("Review Deletions");

            SheetHead {
                icon: Icons.trash;
                tint: Theme.red;
                tint-soft: Theme.red-soft;
                title: @tr("Review Deletions");
                body: @tr("This publish deletes {} files from {} that aren't in the folder, more than the profile's delete guard allows. Deleted files can't be brought back.", Counts.grouped(root.data.deletes), root.data.review-name);
            }
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-bottom: 14px;
                spacing: 8px;

                Text {
                    text: @tr("To go ahead, type {} below.", root.data.review-name);
                    color: Theme.label;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                name-field := Field {
                    label: @tr("Name to confirm");
                    placeholder: root.data.review-name;
                }
            }
            FootRule { }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 8px;
                alignment: end;

                cancel-button := CapsuleButton {
                    text: @tr("Cancel");
                    clicked => { root.cancelled(); }
                }
                delete-button := CapsuleButton {
                    text: @tr("Delete {} Files and Publish", Counts.grouped(root.data.deletes));
                    destructive: true;
                    enabled: root.matches;
                    clicked => { root.confirmed(name-field.text); }
                }
            }
        }
    }
}

// Asks for the Bunny account API key that purges `zone`. Save hands the key to the app, which
// checks it with Bunny (`busy` meanwhile) and closes the sheet, or says what is wrong in `error`.
// The key is typed into a secret field and never shown back.
export component CdnKeySheet inherits Rectangle {
    in property <string> zone;
    in-out property <string> error;
    in property <bool> busy;
    // The key as typed.
    callback save(string);
    callback cancelled();

    property <bool> can-save: !root.busy && key-field.text != "";

    function submit() {
        if (root.can-save) {
            root.save(key-field.text);
        }
    }

    // A message sends the user back to the field.
    changed error => {
        if (root.error != "") {
            key-field.focus();
        }
    }

    init => {
        root.error = "";
        key-field.focus();
    }

    Modal {
        at-first-stop: key-field.has-focus;
        at-last-stop: root.can-save ? save-button.has-focus : cancel-button.has-focus;
        cancel => { root.cancelled(); }
        confirm => { root.submit(); }
        focus-first => { key-field.focus(); }
        focus-last => {
            if (root.can-save) {
                save-button.focus();
            } else {
                cancel-button.focus();
            }
        }

        AttachedSheet {
            sheet-width: 500px;
            label: @tr("Bunny Account Key");

            SheetHead {
                icon: Icons.key;
                title: @tr("Bunny Account Key");
                body: @tr("Purging needs your Bunny account API key. HTTPorter keeps it in Windows Credential Manager.");
            }
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-bottom: 14px;
                spacing: 8px;

                FormRow {
                    label: @tr("API key");

                    key-field := SecretField {
                        label: @tr("Bunny account API key");
                        placeholder: @tr("Account settings › API key");
                        show-label: @tr("Show key");
                        hide-label: @tr("Hide key");
                        error: root.error;
                        edited => { root.error = ""; }
                        accepted => { root.submit(); }
                    }
                    if root.error != "": ErrorLine { text: root.error; }
                }
                Text {
                    text: @tr("It purges the pull zones in front of the storage zone {}.", root.zone);
                    color: Theme.label2;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
            FootRule { }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 8px;

                if root.busy: VCenter {
                    Text {
                        text: @tr("Checking the key with Bunny…");
                        color: Theme.label2;
                        font-size: Theme.font-body;
                        accessible-live-region: polite;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                cancel-button := CapsuleButton {
                    text: @tr("Cancel");
                    clicked => { root.cancelled(); }
                }
                save-button := CapsuleButton {
                    text: @tr("Save");
                    primary: true;
                    enabled: root.can-save;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}
