// Left sidebar (mockup `.sidebar`): the site list, the publish profiles, the favorites, the files
// being edited and the Add Site / Settings footer.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { EditItem, PlaceItem, ProfileItem, SiteItem } from "../types.slint";
import { HealthMark, MonoTile } from "chips.slint";
import { Activation, CapsuleButton, ToolButton } from "buttons.slint";
import { VCenter } from "layout.slint";

// Section heading (mockup `.sb-sec`: padding 12px 8px 4px).
component SectionTitle inherits Rectangle {
    in property <string> text;

    height: 31px + Theme.grow-small;

    Text {
        x: 8px;
        y: 12px;
        text: root.text;
        color: Theme.label2;
        font-size: Theme.font-small;
        font-weight: Theme.weight-semibold;
    }
}

// One site: provider tile, name over subtitle, health mark (mockup `.sb-item` with `.sb-two`).
// The site list is one Tab stop (ledger 155): Tab reaches the row the list last had (`tab-stop`),
// Up and Down (Home, End) move along it, Space or Return selects the row. A right click, the Menu
// key or Shift+F10 asks for its context menu, at a point of the window.
component SiteRow inherits Rectangle {
    in property <SiteItem> site;
    in property <bool> selected;
    // The row Tab lands on in the site list.
    in property <bool> tab-stop;
    // Goes up when the list moves the keyboard to a row: the row that is `tab-stop` then takes
    // the focus.
    in property <int> focus-ask;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();
    callback context-pressed(Point);
    // Up (-1), Down (1), Home (-1000000) or End (1000000) on the row.
    callback step(int);

    min-height: Theme.sidebar-item-height;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.sel-quiet : (area.has-hover ? Theme.hover : transparent);
    forward-focus: key-focus;
    accessible-role: list-item;
    // The health is in the words too, not only in the mark (ledger 130).
    accessible-label: root.site.healthy ? @tr("{}, {}", root.site.name, root.site.subtitle) : @tr("{}, {}, last request failed", root.site.name, root.site.subtitle);
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    changed focus-ask => {
        if (root.tab-stop) {
            key-focus.focus();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        VCenter { MonoTile { mono: root.site.mono; tint: Theme.provider-tint(root.site.provider); } }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.site.name;
                color: Theme.label;
                font-size: Theme.font-body;
                font-weight: root.selected ? Theme.weight-medium : Theme.weight-regular;
                overflow: elide;
            }
            Text {
                text: root.site.subtitle;
                color: Theme.label2;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        VCenter { HealthMark { ok: root.site.healthy; } }
    }

    // Focus ring inside the row: the scroll view around the list would clip one drawn outside.
    Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    // Zero width so that clicks do not focus it (the ring is for keyboard focus only).
    key-focus := FocusScope {
        x: 0;
        width: 0;
        focus-on-tab-navigation: root.tab-stop;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            if (!event.modifiers.alt && !event.modifiers.control && !event.modifiers.shift) {
                if (event.text == Key.UpArrow) {
                    root.step(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.step(1);
                    return accept;
                }
                if (event.text == Key.Home) {
                    root.step(-1000000);
                    return accept;
                }
                if (event.text == Key.End) {
                    root.step(1000000);
                    return accept;
                }
            }
            // The Menu key and Shift+F10: the row's context menu, at its left.
            if (event.text == Key.Menu || (event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt && event.text == Key.F10)) {
                root.context-pressed({
                    x: root.absolute-position.x + 32px,
                    y: root.absolute-position.y + root.height / 2,
                });
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.context-pressed({
                    x: self.absolute-position.x + self.mouse-x,
                    y: self.absolute-position.y + self.mouse-y,
                });
            }
        }
    }
}

// One publish profile (mockup `.sb-item` in the Publish section): the send icon, its name and when
// it last published ("2h ago", "Never"). Reachable with Tab, chosen with Space or Return.
component ProfileRow inherits Rectangle {
    in property <ProfileItem> profile;
    in property <bool> selected;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    height: Theme.sidebar-item-height;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.sel-quiet : (area.has-hover ? Theme.hover : transparent);
    forward-focus: key-focus;
    accessible-role: list-item;
    accessible-label: @tr("{}, last published {}", root.profile.name, root.profile.meta);
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        VCenter {
            Image {
                source: Icons.send;
                colorize: root.selected ? Theme.accent-text : Theme.label2;
                width: 16px;
                height: 16px;
                accessible-role: none;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.profile.name;
            color: Theme.label;
            font-size: Theme.font-body;
            font-weight: root.selected ? Theme.weight-medium : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: root.profile.meta;
            color: Theme.label2;
            font-size: Theme.font-small;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A favorite or a file being edited (mockup `.sb-item` in Favorites and Editing): an icon, the
// name and, at the right, a short note (the site or the folder it is in; the edit's state).
// Reachable with Tab, opened with Space or Return; a right click, the Menu key or Shift+F10 asks
// for its menu, at a point of the window.
component ItemRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> meta;
    in property <color> meta-color: Theme.label2;
    // What assistive technology reads for the row.
    in property <string> label;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();
    callback context-pressed(Point);

    height: Theme.sidebar-item-height;
    border-radius: Theme.radius-sm;
    background: area.has-hover ? Theme.hover : transparent;
    forward-focus: key-focus;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        VCenter {
            Image {
                source: root.icon;
                colorize: Theme.label2;
                width: 16px;
                height: 16px;
                accessible-role: none;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Theme.label;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        if root.meta != "": Text {
            max-width: 104px;
            text: root.meta;
            color: root.meta-color;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            if (event.text == Key.Menu || (event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt && event.text == Key.F10)) {
                root.context-pressed({
                    x: root.absolute-position.x + 32px,
                    y: root.absolute-position.y + root.height / 2,
                });
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.context-pressed({
                    x: self.absolute-position.x + self.mouse-x,
                    y: self.absolute-position.y + self.mouse-y,
                });
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[SiteItem]> sites;
    in property <int> selected-site: -1;
    // True while the Add Site sheet is open over the window. When it closes, the keyboard focus
    // goes back to the Add Site button, which is where the user started.
    in property <bool> sheet-open;
    // There is no Settings window yet: until there is, the button is shown turned off and says
    // why, rather than doing nothing when pressed.
    in property <bool> settings-available: false;
    // The site menu's commands can be used (Ruling Q10: off, with a note, until they are wired).
    in property <bool> site-menu-available: false;
    callback site-selected(int);
    // The Publish section: one row per profile, and the one selected (-1 for none). While a
    // profile is selected its page is shown, so no site row is drawn selected.
    in property <[ProfileItem]> profiles;
    in property <int> selected-profile: -1;
    callback profile-selected(int);
    callback add-site();
    callback open-settings();
    // The site menu of row `int`: Edit…, Duplicate, Remove….
    callback edit-site(int);
    callback duplicate-site(int);
    callback remove-site(int);
    // ---- Manage+ (I4, T6) ----
    // The Favorites section: a click opens the place; its menu has Remove.
    in property <[PlaceItem]> favorites;
    callback favorite-selected(int);
    callback favorite-remove(int);
    // The Editing section: a row per file being edited; its menu has Stop.
    in property <[EditItem]> edits;
    callback edit-selected(int);
    callback edit-stop(int);

    // The row the site menu was opened on.
    property <int> menu-site: -1;
    // The site row Tab lands on (ledger 155: the list is one Tab stop): the one the keyboard
    // was last on, else the selected one, else the first. `focus-ask` goes up when Up or Down
    // move the keyboard to another row.
    property <int> key-site: -1;
    property <int> tab-site: root.key-site >= 0 && root.key-site < root.sites.length ? root.key-site : (root.selected-site >= 0 && root.selected-site < root.sites.length ? root.selected-site : 0);
    property <int> focus-ask: 0;

    // The keyboard goes `by` rows along the site list, from the row it is on.
    function step-site(by: int) {
        if (root.sites.length > 0) {
            root.key-site = Math.max(0, Math.min(root.sites.length - 1, root.tab-site + by));
            root.focus-ask += 1;
        }
    }
    // The Favorites and Editing rows their menus were opened on.
    property <int> menu-favorite: -1;
    property <int> menu-edit: -1;

    // Opens the site menu of row `index` at `point`, a point of the window.
    function show-site-menu(index: int, point: Point) {
        root.menu-site = index;
        site-menu.show({ x: point.x - root.absolute-position.x, y: point.y - root.absolute-position.y });
    }

    function show-favorite-menu(index: int, point: Point) {
        root.menu-favorite = index;
        favorite-menu.show({ x: point.x - root.absolute-position.x, y: point.y - root.absolute-position.y });
    }

    function show-edit-menu(index: int, point: Point) {
        root.menu-edit = index;
        edit-menu.show({ x: point.x - root.absolute-position.x, y: point.y - root.absolute-position.y });
    }

    background: Theme.sidebar;
    border-radius: Theme.radius-lg;
    border-width: 0.5px;
    border-color: Theme.sep;

    // A click selects a site without moving the keyboard: Tab lands on it next.
    changed selected-site => { root.key-site = root.selected-site; }

    changed sheet-open => {
        if (!root.sheet-open) {
            add-button.focus();
        }
    }

    // Opened only through `show-site-menu` (a right click on a row, the Menu key), so the native
    // trigger is off.
    site-menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: @tr("Edit…");
                enabled: root.site-menu-available;
                activated => { root.edit-site(root.menu-site); }
            }
            MenuItem {
                title: @tr("Duplicate");
                enabled: root.site-menu-available;
                activated => { root.duplicate-site(root.menu-site); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Remove…");
                enabled: root.site-menu-available;
                activated => { root.remove-site(root.menu-site); }
            }
        }
    }

    favorite-menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: @tr("Remove from Favorites");
                activated => { root.favorite-remove(root.menu-favorite); }
            }
        }
    }

    edit-menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: @tr("Stop Editing");
                activated => { root.edit-stop(root.menu-edit); }
            }
        }
    }

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 8px;

        SectionTitle { text: @tr("Sites"); }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                if root.sites.length == 0: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: @tr("No sites yet. Add one to start browsing and publishing.");
                        color: Theme.label2;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }
                for site[i] in root.sites: SiteRow {
                    site: site;
                    selected: i == root.selected-site && root.selected-profile < 0;
                    tab-stop: i == root.tab-site;
                    focus-ask: root.focus-ask;
                    step(by) => { root.step-site(by); }
                    clicked => {
                        root.key-site = i;
                        root.site-selected(i);
                    }
                    context-pressed(point) => { root.show-site-menu(i, point); }
                }
                SectionTitle { text: @tr("Publish"); }
                for profile[i] in root.profiles: ProfileRow {
                    profile: profile;
                    selected: i == root.selected-profile;
                    clicked => { root.profile-selected(i); }
                }
                if root.sites.length > 0 && root.profiles.length == 0: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: @tr("Click Publish to make a profile for the open site.");
                        color: Theme.label2;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }
                if root.sites.length == 0: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: @tr("Publish profiles appear here after you add a site.");
                        color: Theme.label2;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }
                // Favorites: a site's folder has the star, one of this PC the PC.
                if root.favorites.length > 0: SectionTitle { text: @tr("Favorites"); }
                for place[i] in root.favorites: ItemRow {
                    icon: place.remote ? Icons.star : Icons.pc;
                    title: place.name;
                    meta: place.subtitle;
                    label: @tr("{}, {}", place.name, place.subtitle);
                    clicked => { root.favorite-selected(i); }
                    context-pressed(point) => { root.show-favorite-menu(i, point); }
                }
                // Editing: the site's files open in another program, uploaded again when saved.
                if root.edits.length > 0: SectionTitle { text: @tr("Editing"); }
                for item[i] in root.edits: ItemRow {
                    icon: Icons.pencil;
                    title: item.name;
                    meta: item.state;
                    meta-color: item.failed ? Theme.red : Theme.label2;
                    label: @tr("{}, {}", item.name, item.state);
                    clicked => { root.edit-selected(i); }
                    context-pressed(point) => { root.show-edit-menu(i, point); }
                }
            }
        }

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 8px;
            spacing: 6px;

            VCenter {
                add-button := CapsuleButton {
                    text: @tr("Add Site");
                    icon: Icons.plus;
                    clicked => { root.add-site(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VCenter {
                ToolButton {
                    icon: Icons.gear;
                    label: @tr("Settings");
                    description: root.settings-available ? "" : @tr("Settings arrive in a later version");
                    enabled: root.settings-available;
                    clicked => { root.open-settings(); }
                }
            }
        }
    }
}
