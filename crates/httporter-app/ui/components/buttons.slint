// Capsule-shaped buttons from the mockup: `.tbtn` (icon only) and `.btn` (label, optional icon).

import { Theme } from "../theme.slint";
import { VCenter } from "layout.slint";

// Focus ring drawn 3 px outside the control it belongs to, shown while that control has keyboard
// focus, and not once the control is turned off (ledger 153: it may be turned off while focused). The control sizes it (`width`/`height` 6 px larger, `radius` 3 px larger) from its own
// geometry. Place it after the content and before the TouchArea.
component FocusRing inherits Rectangle {
    in property <bool> has-focus;
    in property <length> radius;

    x: -3px;
    y: -3px;
    border-radius: root.radius;
    border-width: 2px;
    border-color: Theme.focus-ring;
    visible: root.has-focus;
}

// Which key presses activate a focused control: Space or Return, not auto-repeat and not with Alt
// held (Alt+Space belongs to the window's system menu, and Alt+Return presses nothing).
export global Activation {
    pure public function triggers(event: KeyEvent) -> bool {
        return !event.repeat && !event.modifiers.alt && (event.text == Key.Space || event.text == Key.Return);
    }
}

// 28 px icon button, transparent until hovered (mockup `.tbtn`).
// Reachable with Tab, activated with Space or Return; a disabled button takes no focus.
export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    // Read out after the label: what it does, or why it is turned off.
    in property <string> description;
    in property <bool> enabled: true;
    in property <bool> active: false;
    // The size of the icon (the mockup's stepper has the 14 px `.ic.sm`).
    in property <length> icon-size: 16px;
    // Held down, the button presses itself again and again, as a stepper's buttons do.
    in property <bool> repeats: false;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    property <bool> held: area.pressed && root.enabled;
    // A held press has begun repeating: its release must not count as one more press.
    property <bool> repeating: false;

    changed held => {
        if (!self.held) {
            root.repeating = false;
        }
    }

    width: 32px;
    height: 28px;
    border-radius: self.height / 2;
    // Hover and press fade in and out (I7, `Theme.motion-hover`).
    background: root.active || root.held ? Theme.sel-quiet : (area.has-hover && root.enabled ? Theme.hover : transparent);
    opacity: root.enabled ? 1 : 0.4;

    animate background { duration: Theme.motion-hover; easing: ease-out; }
    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    Image {
        source: root.icon;
        colorize: Theme.label;
        width: root.icon-size;
        height: root.icon-size;
    }

    Timer {
        interval: 400ms;
        running: root.repeats && root.held && !root.repeating;
        triggered => {
            root.repeating = true;
            root.clicked();
        }
    }

    Timer {
        interval: 60ms;
        running: root.repeats && root.held && root.repeating;
        triggered => { root.clicked(); }
    }

    FocusRing {
        has-focus: root.has-focus && root.enabled;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: parent.border-radius + 3px;
    }

    // Zero width so that clicks do not focus it (the ring is for keyboard focus only).
    key-focus := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (!root.repeating) {
                root.clicked();
            }
        }
    }
}

// 28 px labelled button (mockup `.btn`); `primary` fills with the accent colour, `destructive` writes
// the label in red (mockup `.btn.destructive`), `quiet` has no fill or outline and an accent label
// (mockup `.btn.quiet`), `hairline` has the mockup's thin outline (the Settings window).
// Keyboard behaviour is the same as ToolButton.
export component CapsuleButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> quiet: false;
    in property <bool> hairline: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    property <color> ink: root.primary ? Theme.on-accent : (root.quiet ? Theme.accent-text : (root.destructive ? Theme.red : Theme.label));

    height: Theme.control-height;
    border-radius: self.height / 2;
    // Pressed, the face darkens (the quiet button gets the hover wash); both fade (I7).
    property <bool> down: area.pressed && root.enabled;
    background: root.quiet ? (root.down ? Theme.hover : transparent) : (root.primary ? (root.down ? Theme.accent.darker(0.15) : Theme.accent) : (root.down ? (Theme.dark ? Theme.control.brighter(0.2) : Theme.control.darker(0.06)) : Theme.control));

    animate background { duration: Theme.motion-hover; easing: ease-out; }
    // A plain button is outlined in `field-border` (3:1 against the surface in both themes): the
    // white face of `control` has no other edge on a white sheet. The primary one is a fill.
    border-width: root.quiet ? 0px : (root.primary ? 0.5px : (root.hairline ? 1phx : 1px));
    border-color: root.primary ? transparent : (root.hairline ? Theme.control-border : Theme.field-border);
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0: VCenter {
            Image {
                source: root.icon;
                colorize: root.ink;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.font-body;
            font-weight: root.primary ? Theme.weight-semibold : Theme.weight-medium;
            vertical-alignment: center;
        }
    }

    FocusRing {
        has-focus: root.has-focus && root.enabled;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: parent.border-radius + 3px;
    }

    key-focus := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
