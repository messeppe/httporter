// File pane (mockup `.pane`): a header with icon, title, breadcrumbs and a chip, the Name / Size /
// Modified column headers, and a virtualized list of rows. While Compare is on (`comparing`), a
// Status column between Name and Size shows how each row compares with the other side (Changed,
// New, "Only on Bunny", Same: the app sets each row's `status`), and This PC's header carries the
// accent "Comparing" chip.
//
// Keyboard: Tab reaches the list, then the breadcrumbs, then the three column headers. In the list,
// Up and Down move the selection (Home, End, PageUp and PageDown too; with Shift they extend it),
// Ctrl+A selects every row, Enter opens the row the keyboard is on and Backspace goes up one
// folder. Space or Return on a breadcrumb goes to that folder and on a column header sorts by it.
// Every breadcrumb except the last (the current folder) is a button.
//
// Selection: the pane only reports what was pressed (`row-pointer`, `band-select`, `select-all`);
// the app decides what is selected and sets each row's `selected`. Dragging in the empty space
// below the rows draws a rubber band over the rows it crosses. A right click on a row opens its
// context menu (cloud or This PC rows have their own).
//
// Drag and drop: pressing a row and moving 4 px starts a drag of the pane's selection to the other
// pane (the pane reports `drag-moved`, `drag-ended`, `drag-cancelled`; the window draws the ghost
// and decides what is under it). Pressing a row that is already selected waits for the button to
// come up before it narrows the selection, so that a whole selection can be dragged. Files from
// Explorer, or from the other pane, over this one light it up (`drop-hover`), and a folder row
// under them too (`drop-row`). Ctrl+V in the cloud pane asks to paste.
//
// Grid (`grid`, the inspector view's Thumbnails): the same rows as tiles (PaneTile) with their
// `thumb`, without the column headers. The arrows move item by item and line by line; pressing
// below the last line clears the selection; a drop goes into the folder shown.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { CompareStatus, CompareSummary, FileKind, FileRow, PaneBounds } from "../types.slint";
import { Activation, ToolButton } from "buttons.slint";
import { Chip, StatusChip } from "chips.slint";
import { VCenter } from "layout.slint";

// Sizes shared by the column headers and the rows (mockup `.cols, .row`: padding 0 12px, gap 8px).
// The Status, Size and Modified columns are as wide as the window says (`Pane.col-*-width`, the
// user drags them, from `narrowest` to `widest`); these are their defaults, which a double click on a
// column's handle restores.
global Cols {
    out property <length> pad: 12px;
    out property <length> gap: 8px;
    // The Status column, while comparing (mockup: 96px).
    out property <length> status: 96px;
    out property <length> size: 76px;
    out property <length> modified: 128px;
    out property <length> narrowest: 60px;
    out property <length> widest: 400px;
    // The drag handle on a column's left edge.
    out property <length> handle: 6px;

    pure public function clamp(width: length) -> length {
        return Math.max(narrowest, Math.min(widest, width));
    }
}

// The thumbnail grid (I4: the inspector view's Thumbnails layout): 120 px tiles, as many to a line
// as fit after `pad` on each side. src/manage/thumbs.rs works out which tiles are in view from
// the same sizes (TILE_WIDTH, TILE_HEIGHT, GRID_PAD).
global Grid {
    out property <length> tile-w: 120px;
    out property <length> tile-h: 132px;
    out property <length> pad: 4px;
    // The thumbnail's square inside a tile, and the name's two lines under it.
    out property <length> thumb: 88px;
}

// The whole name of a breadcrumb cut short, shown when the pointer rests on it (ledger 202).
component CrumbTip inherits Rectangle {
    in property <string> text;

    background: Theme.sheet;
    border-radius: 6px;
    border-width: 0.5px;
    border-color: Theme.sep-strong;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;

        Text {
            text: root.text;
            color: Theme.label;
            font-size: Theme.font-caption;
        }
    }
}

// One breadcrumb that goes to its folder when pressed (mockup `.crumbs`), in the secondary text
// colour. Reachable with Tab, activated with Space or Return. A name cut short shows whole in a
// tooltip.
component Crumb inherits Rectangle {
    in property <string> text;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    forward-focus: key-focus;
    border-radius: 4px;
    background: area.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: @tr("Go to {}", root.text);
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;

        label := Text {
            text: root.text;
            color: Theme.label2;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    // Focus ring, as on the column headers: inside the control's own bounds.
    Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    // Zero width so that clicks do not focus it (the ring is for keyboard focus only).
    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    if label.width < label.preferred-width: Tooltip {
        CrumbTip { text: root.text; }
    }
}

// The last breadcrumb: the folder shown, in plain text, keeping its name (up to 160 px) while
// the crumbs before it shrink. A name cut short shows whole in a tooltip.
component CurrentCrumb inherits Rectangle {
    in property <string> text;

    min-width: Math.min(label.preferred-width, 160px) + 6px;
    preferred-width: label.preferred-width + 6px;

    label := Text {
        x: 3px;
        width: parent.width - 6px;
        height: parent.height;
        text: root.text;
        color: Theme.label;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-medium;
        vertical-alignment: center;
        overflow: elide;
    }

    if label.width < label.preferred-width: Tooltip {
        CrumbTip { text: root.text; }
    }
}

// The drag handle on a column's left edge (§8.7.6): dragging it left widens the column, right
// narrows it; a double click puts the default width back. The pointer only: the columns are not
// keyboard controls.
component ColumnHandle inherits Rectangle {
    // The column's width as the drag began.
    in property <length> start-width;
    callback resized(length);
    callback reset();

    width: Cols.handle;

    area := TouchArea {
        property <length> press-x;
        property <length> from;

        mouse-cursor: col-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.press-x = self.absolute-position.x + self.mouse-x;
                self.from = root.start-width;
            }
        }
        moved => {
            if (self.pressed) {
                root.resized(Cols.clamp(self.from - (self.absolute-position.x + self.mouse-x - self.press-x)));
            }
        }
        double-clicked => { root.reset(); }
    }

    // A hairline while the pointer is on it, so that the handle can be found.
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 1px;
        height: parent.height - 8px;
        background: Theme.sep-strong;
        visible: area.has-hover || area.pressed;
    }
}

// One column title that sorts the list when pressed (mockup `.cols`). The sorted column is shown
// in the label colour with a caret that points up for ascending and down for descending (two
// icons: the software renderer does not rotate images).
// Reachable with Tab, activated with Space or Return.
component ColumnHeader inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> ascending: true;
    in property <bool> right-aligned: false;
    // The column can be made wider or narrower from a handle on its left edge.
    in property <bool> resizable: false;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();
    callback resized(length);
    callback reset();

    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.sorted ? (root.ascending ? @tr("{}, sorted ascending", root.text) : @tr("{}, sorted descending", root.text)) : @tr("Sort by {}", root.text);
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        alignment: root.right-aligned ? end : start;
        spacing: 4px;

        Text {
            text: root.text;
            color: root.sorted ? Theme.label : Theme.label2;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.sorted: VCenter {
            Image {
                source: root.ascending ? Icons.sort : Icons.sort-down;
                colorize: Theme.label;
                width: 12px;
                height: 12px;
                accessible-role: none;
            }
        }
    }

    // Focus ring, 4 px wider than the text on each side so that it does not touch the letters.
    Rectangle {
        x: -4px;
        width: parent.width + 8px;
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.focus-ring;
        visible: root.has-focus;
    }

    // Zero width so that clicks do not focus it (the ring is for keyboard focus only).
    key-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (Activation.triggers(event)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }

    // In the gap before the column, over the sort area's edge.
    if root.resizable: ColumnHandle {
        x: -(Cols.gap + Cols.handle) / 2;
        height: parent.height;
        start-width: root.width;
        resized(width) => { root.resized(width); }
        reset => { root.reset(); }
    }
}

// Shown in the pane's header while a listing for it is on its way (mockup `.chip`, neutral). The
// rows below are still those of the folder shown until the answer arrives. A polite live region,
// so assistive technology announces it.
component LoadingMark inherits Rectangle {
    height: Theme.chip-height;
    background: Theme.chip;
    border-radius: self.height / 2;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("Loading…");
    accessible-live-region: polite;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;

        VCenter {
            Image {
                source: Icons.refresh;
                colorize: Theme.label2;
                width: 14px;
                height: 14px;
                accessible-role: none;
            }
        }
        Text {
            text: @tr("Loading…");
            color: Theme.label2;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The pill that says what letting go of dragged files does (mockup `.chip`, filled with the accent).
// A long folder name is cut with an ellipsis rather than overflowing the pane.
component DropChip inherits Rectangle {
    in property <string> text;
    in property <image> icon;

    height: Theme.chip-height + 4px;
    background: Theme.accent;
    border-radius: self.height / 2;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;

        VCenter {
            Image {
                source: root.icon;
                colorize: Theme.on-accent;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.text;
            color: Theme.on-accent;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One file or folder (mockup `.row`): folder disclosure chevron, kind icon and name, then size and
// modified date. Alternate rows get the `row-alt` background; the selected row fills with the
// accent colour and white text.
component PaneRow inherits Rectangle {
    in property <FileRow> item;
    in property <int> index;
    in property <int> count;
    in property <bool> selected;
    // The folder that files being dragged over the pane would go into: the row is outlined.
    in property <bool> drop-target: false;
    // A drag may start from the row (the pane has somewhere to send what it holds).
    in property <bool> drag-ok: false;
    // Compare is on: the Status column shows, and `remote-label` names the site's side in "Only on
    // Bunny" / "Only on {site}".
    in property <bool> comparing: false;
    in property <string> remote-label;
    // The Status, Size and Modified columns' widths (the pane's `col-*-width`).
    in property <length> status-width: Cols.status;
    in property <length> size-width: Cols.size;
    in property <length> modified-width: Cols.modified;
    // The left button went down on the row, with the Ctrl and Shift keys as they were.
    callback pressed(bool /* ctrl */, bool /* shift */);
    // The left button went down on a selected row, with neither Ctrl nor Shift: `pressed` waits
    // until the button comes up without a drag, so that the whole selection can be dragged.
    callback held();
    // The right button went down on the row, at this point of the window.
    callback context-pressed(Point);
    callback opened();
    // A drag out of the row began (the pointer moved 4 px with the button down) and moved to this
    // point of the window; the button came up there; or the pointer was taken away from the row.
    callback drag-moved(Point);
    callback drag-ended(Point);
    callback drag-cancelled();

    // Selected and not under a drop: the accent fill with white text.
    property <bool> lit: root.selected && !root.drop-target;

    property <string> kind-label: root.item.kind == FileKind.code ? @tr("code file") : root.item.kind == FileKind.image ? @tr("image") : @tr("document");
    property <image> kind-icon: root.item.kind == FileKind.folder ? Icons.folder : root.item.kind == FileKind.code ? Icons.code : root.item.kind == FileKind.image ? Icons.image : Icons.doc;
    property <color> kind-color: root.lit ? Theme.sel-text : root.item.kind == FileKind.folder ? Theme.folder : root.item.kind == FileKind.image ? Theme.green : Theme.label2;
    property <color> detail-color: root.lit ? Theme.sel-text : Theme.label2;
    property <string> status-text: root.item.status == CompareStatus.changed ? @tr("Changed") : root.item.status == CompareStatus.new ? @tr("New") : root.item.status == CompareStatus.remote-only ? @tr("Only on {}", root.remote-label) : root.item.status == CompareStatus.same ? @tr("Same") : "";

    height: Theme.row-height;
    background: root.drop-target ? Theme.accent-soft : root.selected ? Theme.sel : (Math.mod(root.index, 2) == 1 ? Theme.row-alt : transparent);
    border-width: root.drop-target ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: list-item;
    accessible-label: root.item.folder ? @tr("{}, folder, modified {}", root.item.name, root.item.modified) : @tr("{}, {}, {}, modified {}", root.item.name, root.kind-label, root.item.size, root.item.modified);
    accessible-description: root.comparing ? root.status-text : "";
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-action-default => { root.opened(); }

    HorizontalLayout {
        padding-left: Cols.pad;
        padding-right: Cols.pad;
        spacing: Cols.gap;

        Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;

                VCenter {
                    Image {
                        source: Icons.chev-r;
                        colorize: root.lit ? Theme.sel-text : Theme.label3;
                        opacity: root.item.folder ? 1 : 0;
                        width: 10px;
                        height: 10px;
                        accessible-role: none;
                    }
                }
                VCenter {
                    Image {
                        source: root.kind-icon;
                        colorize: root.kind-color;
                        width: 16px;
                        height: 16px;
                        accessible-role: none;
                    }
                }
                Text {
                    text: root.item.name;
                    color: root.lit ? Theme.sel-text : Theme.label;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }
        // Status (mockup: a chip at the start of the column).
        if root.comparing: Rectangle {
            width: root.status-width;

            StatusChip {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: Math.min(self.preferred-width, parent.width);
                status: root.item.status;
                text: root.status-text;
                lit: root.lit;
            }
        }
        Text {
            text: root.item.size;
            width: root.size-width;
            color: root.detail-color;
            font-size: Theme.font-caption;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: root.item.modified;
            width: root.modified-width;
            color: root.detail-color;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    area := TouchArea {
        // The left button is down on the row.
        property <bool> armed: false;
        // It has moved 4 px since: this is a drag, not a click.
        property <bool> dragging: false;
        // `pressed` is owed for when the button comes up (see `held`).
        property <bool> owed: false;
        // Where the button went down, in the window.
        property <length> press-x;
        property <length> press-y;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    self.press-x = self.absolute-position.x + self.mouse-x;
                    self.press-y = self.absolute-position.y + self.mouse-y;
                    self.armed = true;
                    self.dragging = false;
                    if (root.selected && !event.modifiers.control && !event.modifiers.shift) {
                        self.owed = true;
                        root.held();
                    } else {
                        self.owed = false;
                        root.pressed(event.modifiers.control, event.modifiers.shift);
                    }
                } else if (event.button == PointerEventButton.right) {
                    root.context-pressed({
                        x: area.absolute-position.x + area.mouse-x,
                        y: area.absolute-position.y + area.mouse-y,
                    });
                }
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                let was-dragging = self.dragging;
                let was-owed = self.owed;
                self.armed = false;
                self.dragging = false;
                self.owed = false;
                if (was-dragging) {
                    root.drag-ended({
                        x: self.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y + self.mouse-y,
                    });
                } else if (was-owed) {
                    root.pressed(false, false);
                }
            } else if (event.kind == PointerEventKind.cancel) {
                let was-dragging = self.dragging;
                self.armed = false;
                self.dragging = false;
                self.owed = false;
                if (was-dragging) {
                    root.drag-cancelled();
                }
            }
        }
        moved => {
            if (self.armed && root.drag-ok) {
                let x = self.absolute-position.x + self.mouse-x;
                let y = self.absolute-position.y + self.mouse-y;
                if (!self.dragging) {
                    let dx = (x - self.press-x) / 1px;
                    let dy = (y - self.press-y) / 1px;
                    if (Math.sqrt(dx * dx + dy * dy) >= 4) {
                        self.dragging = true;
                    }
                }
                if (self.dragging) {
                    root.drag-moved({ x: x, y: y });
                }
            }
        }
        double-clicked => { root.opened(); }
    }
}

// One file or folder of the grid (Finder's icon view): its thumbnail (the app sets the row's
// `thumb` for an image) or its kind's icon on a rounded square, and its name under it, two lines
// at most. The selected tile's square is shaded and its name sits on the accent colour. Pointer
// and drag behaviour are PaneRow's.
component PaneTile inherits Rectangle {
    in property <FileRow> item;
    in property <int> index;
    in property <int> count;
    in property <bool> drop-target: false;
    in property <bool> drag-ok: false;
    callback pressed(bool /* ctrl */, bool /* shift */);
    callback held();
    callback context-pressed(Point);
    callback opened();
    callback drag-moved(Point);
    callback drag-ended(Point);
    callback drag-cancelled();

    property <bool> lit: root.item.selected && !root.drop-target;
    property <string> kind-label: root.item.kind == FileKind.code ? @tr("code file") : root.item.kind == FileKind.image ? @tr("image") : @tr("document");
    property <image> kind-icon: root.item.kind == FileKind.folder ? Icons.folder : root.item.kind == FileKind.code ? Icons.code : root.item.kind == FileKind.image ? Icons.image : Icons.doc;
    property <color> kind-color: root.item.kind == FileKind.folder ? Theme.folder : root.item.kind == FileKind.image ? Theme.green : Theme.label2;

    width: Grid.tile-w;
    height: Grid.tile-h;
    accessible-role: list-item;
    accessible-label: root.item.folder ? @tr("{}, folder, modified {}", root.item.name, root.item.modified) : @tr("{}, {}, {}, modified {}", root.item.name, root.kind-label, root.item.size, root.item.modified);
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-action-default => { root.opened(); }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: Grid.thumb;
        height: Grid.thumb;
        border-radius: 8px;
        background: root.drop-target ? Theme.accent-soft : (root.item.selected ? Theme.sel-quiet : transparent);
        border-width: root.drop-target ? 2px : 0px;
        border-color: Theme.accent;

        if root.item.thumb.width > 0: Image {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            source: root.item.thumb;
            image-fit: contain;
            accessible-role: none;
        }
        if root.item.thumb.width == 0: Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 48px;
            height: 48px;
            source: root.kind-icon;
            colorize: root.kind-color;
            accessible-role: none;
        }
    }

    Rectangle {
        x: 4px;
        y: Grid.thumb + 10px;
        width: parent.width - 8px;
        height: parent.height - self.y - 2px;
        border-radius: 5px;
        background: root.lit ? Theme.sel : transparent;

        Text {
            x: 4px;
            y: 1px;
            width: parent.width - 8px;
            height: parent.height - 2px;
            text: root.item.name;
            color: root.lit ? Theme.sel-text : Theme.label;
            font-size: Theme.font-caption;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: char-wrap;
            overflow: elide;
            accessible-role: none;
        }
    }

    // As PaneRow's: a press selects (or waits for the button to come up on a selected tile, so
    // that the selection can be dragged), 4 px of movement starts a drag, the right button opens
    // the menu and a double click opens the item.
    area := TouchArea {
        property <bool> armed: false;
        property <bool> dragging: false;
        property <bool> owed: false;
        property <length> press-x;
        property <length> press-y;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    self.press-x = self.absolute-position.x + self.mouse-x;
                    self.press-y = self.absolute-position.y + self.mouse-y;
                    self.armed = true;
                    self.dragging = false;
                    if (root.item.selected && !event.modifiers.control && !event.modifiers.shift) {
                        self.owed = true;
                        root.held();
                    } else {
                        self.owed = false;
                        root.pressed(event.modifiers.control, event.modifiers.shift);
                    }
                } else if (event.button == PointerEventButton.right) {
                    root.context-pressed({
                        x: area.absolute-position.x + area.mouse-x,
                        y: area.absolute-position.y + area.mouse-y,
                    });
                }
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                let was-dragging = self.dragging;
                let was-owed = self.owed;
                self.armed = false;
                self.dragging = false;
                self.owed = false;
                if (was-dragging) {
                    root.drag-ended({
                        x: self.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y + self.mouse-y,
                    });
                } else if (was-owed) {
                    root.pressed(false, false);
                }
            } else if (event.kind == PointerEventKind.cancel) {
                let was-dragging = self.dragging;
                self.armed = false;
                self.dragging = false;
                self.owed = false;
                if (was-dragging) {
                    root.drag-cancelled();
                }
            }
        }
        moved => {
            if (self.armed && root.drag-ok) {
                let x = self.absolute-position.x + self.mouse-x;
                let y = self.absolute-position.y + self.mouse-y;
                if (!self.dragging) {
                    let dx = (x - self.press-x) / 1px;
                    let dy = (y - self.press-y) / 1px;
                    if (Math.sqrt(dx * dx + dy * dy) >= 4) {
                        self.dragging = true;
                    }
                }
                if (self.dragging) {
                    root.drag-moved({ x: x, y: y });
                }
            }
        }
        double-clicked => { root.opened(); }
    }
}

// A pane of files: "This PC" on the left, the cloud site on the right.
export component Pane inherits Rectangle {
    in property <string> title;
    // Compare is on (T6 builds the Status column, the chips and This PC's "Comparing" chip), and
    // what it found.
    in property <bool> comparing: false;
    in property <CompareSummary> compare;
    in property <image> icon;
    in property <[string]> crumbs;
    in property <[FileRow]> rows;
    in property <string> header-chip;
    // Files are being dragged over this pane, from Explorer or from the other pane: it shows the
    // accent ring and a chip that says what letting go does ("Release to upload" on the cloud
    // pane, "Release to download" on This PC). Slint's own drop events do not see files from other
    // apps, so the window sets this from the OS drag events (and from its own drag).
    in property <bool> drop-hover: false;
    // The folder row (index into `rows`) that letting go would put the files into, shown while
    // `drop-hover`; -1 for the folder the pane is showing.
    in property <int> drop-row: -1;
    // A listing for this pane is on its way: the header says "Loading…" until it is in, if that
    // takes more than 200 ms (a quicker listing flashes nothing, and a screen reader says nothing).
    in property <bool> loading: false;
    // The header's Refresh button can be pressed (the cloud pane needs a site).
    in property <bool> can-refresh: true;
    // The cloud pane (its rows and context menu), as opposed to This PC.
    in property <bool> cloud: false;
    // What the toolbar may do now; the context menus offer the same.
    in property <bool> can-upload: false;
    in property <bool> can-download: false;
    in property <bool> can-new-folder: false;
    in property <bool> can-delete: false;
    // ---- Manage+ (I4) ----
    // The open site takes writes (not read-only): Rename…, Move To… and the other I4 writes.
    in property <bool> can-write: false;
    // The site can make pre-signed links: the menu offers Copy Presigned Link….
    in property <bool> presign-available: false;
    // Purge from CDN may be chosen.
    in property <bool> can-purge: false;
    // The rows as a grid of thumbnails (T5) rather than a list.
    in property <bool> grid: false;
    // The Status, Size and Modified columns' widths (§8.7.6: both panes share them, and the app
    // keeps them between runs). Dragging a column's handle changes them here and then calls
    // `columns-resized`.
    in-out property <length> col-status-width: Cols.status;
    in-out property <length> col-size-width: Cols.size;
    in-out property <length> col-modified-width: Cols.modified;
    callback columns-resized();
    callback quick-look();
    callback rename-start();
    callback move-start();
    callback copy-link();
    callback copy-path();
    callback copy-presigned();
    // Add to Favorites, for the folder row given.
    callback add-favorite(int);
    callback purge();
    // Index into `rows` of the row the keyboard is on (the focus), or -1 for none. Which rows are
    // selected is in each row's `selected`.
    in-out property <int> selected: -1;
    // Sorted column: 0 name, 1 size, 2 modified. Pressing a column header changes these two and
    // then calls `sort`.
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-ascending: true;
    out property <bool> has-focus: key-focus.has-focus;
    // True when the keyboard (not the mouse) last drove the focus: the strong focus ring shows then.
    out property <bool> focus-visible: root.has-focus && root.keyboard-focus;
    callback open(int);
    callback up();
    // A row was pressed, or the keyboard landed on it: its index, and whether Ctrl and Shift were
    // held.
    callback row-pointer(int, bool, bool);
    // The rubber band covers the rows from the first to the last index (both -1 when it covers
    // none); the last argument is true when Ctrl was held, to add to the selection.
    callback band-select(int, int, bool);
    callback select-all();
    // The context menus and the shortcuts' commands. The app acts on the selection.
    callback upload();
    callback download();
    callback download-to();
    callback new-folder();
    callback delete();
    // The header's Refresh button, the context menu's Refresh: list the folder shown again.
    callback refresh();
    // A key reached the pane from one of its parts that is not the list (a breadcrumb or a column
    // header): the pane holds the keyboard focus.
    callback key-inside();
    // Ctrl+V in the cloud pane: upload the files on the clipboard into the folder shown.
    callback paste();
    // A drag out of a row of this pane: it moved to this point of the window (the first call is
    // the start, 4 px from where the button went down), the button came up there, or the drag was
    // taken away. Nothing is sent unless the pane has somewhere to send its rows (`can-drag`).
    callback drag-moved(Point);
    callback drag-ended(Point);
    callback drag-cancelled();
    // The row (index into `rows`) that the menu was opened on.
    callback show-in-explorer(int);
    // A breadcrumb other than the last was pressed: the index into `crumbs`, 0 being the root.
    callback crumb-clicked(int);
    callback sort(int);

    // Where the pane and its list are in the window, for hit-testing a dragged file's position
    // (src/drop_hook.rs reads it for the files from Explorer, the window for its own drag).
    // In the grid, `row-height` and `scroll-y` are the grid's lines (for src/manage/thumbs.rs),
    // and `rows` is 0: a drop lands in the folder shown rather than on a tile.
    out property <PaneBounds> bounds: {
        x: root.absolute-position.x,
        y: root.absolute-position.y,
        width: root.width,
        height: root.height,
        list-top: list-area.absolute-position.y,
        row-height: root.grid ? Grid.tile-h : Theme.row-height,
        scroll-y: root.grid ? -grid-list.content-y : -list.content-y,
        rows: root.grid ? 0 : root.rows.length,
    };

    // The grid's tiles to a line, and its lines.
    property <int> grid-cols: Math.max(1, Math.floor((list-area.width - 2 * Grid.pad) / Grid.tile-w));
    property <int> grid-lines: Math.ceil(root.rows.length / root.grid-cols);
    // The tiles' lines that fit in view, for PageUp and PageDown in the grid.
    property <int> grid-page: Math.max(1, Math.floor(grid-list.visible-height / Grid.tile-h));

    property <bool> keyboard-focus: false;
    // `loading` for 200 ms: only then does the header show the "Loading…" mark.
    property <bool> show-loading: false;
    // The row the open context menu is for, or -1.
    property <int> context-row: -1;
    property <bool> context-folder: root.context-row >= 0 && root.context-row < root.rows.length && root.rows[root.context-row].folder;
    // A drag out of a row may start: This PC can upload and the cloud pane can download, which the
    // toolbar's rules (`can-upload`, `can-download`) already say.
    property <bool> can-drag: root.cloud ? root.can-download : root.can-upload;

    // Whether the point (x, y) of the window is inside the pane.
    public pure function contains(x: length, y: length) -> bool {
        return x >= root.absolute-position.x && x < root.absolute-position.x + root.width && y >= root.absolute-position.y && y < root.absolute-position.y + root.height;
    }

    // The folder row under the height y of the window, or -1 when that is over a file, the empty
    // space below the rows, or not the list.
    // In the grid there is none: a drop goes into the folder shown.
    public pure function folder-at(y: length) -> int {
        let row = Math.floor((y - list-area.absolute-position.y - list.content-y) / Theme.row-height);
        return !root.grid && y >= list-area.absolute-position.y && row >= 0 && row < root.rows.length && root.rows[row].folder ? row : -1;
    }

    forward-focus: key-focus;
    accessible-role: region;
    accessible-label: root.title;

    function pick(index: int, ctrl: bool, shift: bool) {
        root.selected = index;
        root.keyboard-focus = false;
        key-focus.focus();
        root.row-pointer(index, ctrl, shift);
    }

    // The keyboard goes to a row; with `extend` (Shift) the selection grows to it.
    function move-to(index: int, extend: bool) {
        if (root.rows.length > 0) {
            root.selected = Math.max(0, Math.min(root.rows.length - 1, index));
            root.row-pointer(root.selected, false, extend);
        }
    }

    // Opens the context menu for `row` at `at`, a point of the card.
    function show-menu(row: int, at: Point) {
        root.context-row = row;
        if (root.cloud) {
            cloud-menu.show(at);
        } else {
            local-menu.show(at);
        }
    }

    // The right button went down on row `index` at `point` (window coordinates): the row joins
    // the selection unless it is in it already, then the menu opens.
    function row-menu(index: int, point: Point) {
        if (!root.rows[index].selected) {
            root.pick(index, false, false);
        }
        root.show-menu(index, { x: point.x - card.absolute-position.x, y: point.y - card.absolute-position.y });
    }

    // A breadcrumb was pressed. The app answers with the new path, which rebuilds the crumbs and
    // would drop the keyboard focus with the pressed one, so the list takes it now. The strong
    // ring shows when the crumb was pressed from the keyboard, as it does for the list itself.
    function go-to-crumb(index: int, from-keyboard: bool) {
        root.keyboard-focus = from-keyboard;
        key-focus.focus();
        root.crumb-clicked(index);
    }

    function sort-by(column: int) {
        if (root.sort-column == column) {
            root.sort-ascending = !root.sort-ascending;
        } else {
            root.sort-column = column;
            root.sort-ascending = true;
        }
        root.sort(column);
    }

    // Scroll so that the selected row is fully in view; with no selection, back to the top. Does
    // nothing before the list has been laid out (its visible height is 0 then).
    function reveal() {
        if (root.grid) {
            root.reveal-tile();
            return;
        }
        if (list.visible-height <= 0px) {
            return;
        }
        if (root.selected < 0) {
            list.content-y = 0px;
        } else if (root.selected < root.rows.length) {
            if (root.selected * Theme.row-height < -list.content-y) {
                list.content-y = -root.selected * Theme.row-height;
            } else if ((root.selected + 1) * Theme.row-height > -list.content-y + list.visible-height) {
                if ((root.selected + 1) * Theme.row-height > -list.content-y + 1.5 * list.visible-height) {
                    // A long way down: the list snaps a jump of more than a screen and a half to a
                    // whole row, so line the row up with the top of the list, where that is exact.
                    list.content-y = -root.selected * Theme.row-height;
                } else {
                    list.content-y = list.visible-height - (root.selected + 1) * Theme.row-height;
                }
            }
        }
    }

    // As `reveal`, in the grid: the line of the selected tile.
    function reveal-tile() {
        if (grid-list.visible-height <= 0px) {
            return;
        }
        if (root.selected < 0) {
            grid-list.content-y = 0px;
        } else if (root.selected < root.rows.length) {
            let top = Math.floor(root.selected / root.grid-cols) * Grid.tile-h;
            if (top < -grid-list.content-y) {
                grid-list.content-y = -top;
            } else if (top + Grid.tile-h > -grid-list.content-y + grid-list.visible-height) {
                grid-list.content-y = grid-list.visible-height - top - Grid.tile-h;
            }
        }
    }

    // The keyboard moves `by` items in the grid (a line is `grid-cols`); with nothing selected
    // it lands on the first item, or the last going back.
    function step(by: int, extend: bool) {
        root.keyboard-focus = true;
        if (root.selected < 0) {
            root.move-to(by > 0 ? 0 : root.rows.length - 1, extend);
        } else {
            root.move-to(root.selected + by, extend);
        }
    }

    changed selected => { root.reveal(); }
    changed grid => { root.reveal(); }

    // The mark appears 200 ms into a listing and goes with it. The timer runs while `loading`,
    // so a listing that is in sooner never shows it.
    changed loading => {
        if (!root.loading) {
            root.show-loading = false;
        }
    }
    Timer {
        interval: 200ms;
        running: root.loading;
        triggered => { root.show-loading = true; }
    }

    // First child, so that the list is the pane's first Tab stop, ahead of the column headers. Zero
    // width so that clicks do not focus it; a click on a row focuses it through `pick`.
    key-focus := FocusScope {
        x: 0;
        width: 0;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                root.keyboard-focus = true;
            }
        }
        key-pressed(event) => {
            // Ctrl+A: every row.
            if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift && (event.text == "a" || event.text == "A")) {
                root.keyboard-focus = true;
                root.select-all();
                return accept;
            }
            // The Menu key and Shift+F10: the context menu of the row the keyboard is on, at the
            // left of that row (or at the top of the list when there is none).
            if (event.text == Key.Menu || (event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt && event.text == Key.F10)) {
                root.keyboard-focus = true;
                root.show-menu(root.selected, {
                    x: 48px,
                    y: root.selected < 0 || root.grid ? 70px : Math.max(63px, Math.min(card.height - 4px, 63px + list.content-y + (root.selected + 0.5) * Theme.row-height)),
                });
                return accept;
            }
            // Ctrl+V in the cloud pane: paste the files on the clipboard (offered while Upload is).
            if (root.cloud && event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift && (event.text == "v" || event.text == "V")) {
                if (!event.repeat && root.can-upload) {
                    root.paste();
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            // The grid: Left and Right go item by item, Up and Down line by line.
            if (root.grid) {
                if (event.text == Key.RightArrow) {
                    root.step(1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.step(-1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.step(root.grid-cols, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.step(-root.grid-cols, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.PageDown) {
                    root.step(Math.max(1, root.grid-page - 1) * root.grid-cols, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.PageUp) {
                    root.step(-Math.max(1, root.grid-page - 1) * root.grid-cols, event.modifiers.shift);
                    return accept;
                }
            }
            if (event.text == Key.DownArrow) {
                root.keyboard-focus = true;
                root.move-to(root.selected + 1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.keyboard-focus = true;
                root.move-to(root.selected < 0 ? root.rows.length - 1 : root.selected - 1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Home) {
                root.keyboard-focus = true;
                root.move-to(0, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.End) {
                root.keyboard-focus = true;
                root.move-to(root.rows.length - 1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.keyboard-focus = true;
                root.move-to(root.selected + Math.max(1, Math.floor(list.visible-height / Theme.row-height) - 1), event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.keyboard-focus = true;
                root.move-to(root.selected - Math.max(1, Math.floor(list.visible-height / Theme.row-height) - 1), event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Return) {
                root.keyboard-focus = true;
                if (!event.repeat && root.selected >= 0 && root.selected < root.rows.length) {
                    root.open(root.selected);
                }
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.keyboard-focus = true;
                if (!event.repeat) {
                    root.up();
                }
                return accept;
            }
            return reject;
        }
    }

    // Soft glow around the pane while it holds the focus (mockup `.pane.focus`).
    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md + 2px;
        background: Theme.accent-soft;
        visible: root.has-focus;
    }

    card := Rectangle {
        background: Theme.content;
        border-radius: Theme.radius-md;
        border-width: 0.5px;
        border-color: Theme.sep-strong;
        clip: true;

        // The context menus, one per kind of pane. They open only through `show-menu` (a right
        // click on a row, the Menu key), after the row has been selected, so the native trigger is
        // off.
        cloud-menu := ContextMenuArea {
            enabled: false;
            Menu {
                MenuItem {
                    title: @tr("Quick Look");
                    enabled: root.context-row >= 0;
                    activated => { root.quick-look(); }
                }
                MenuItem {
                    title: @tr("Open");
                    enabled: root.context-row >= 0;
                    activated => { root.open(root.context-row); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Download");
                    enabled: root.can-download;
                    activated => { root.download(); }
                }
                MenuItem {
                    title: @tr("Download to…");
                    enabled: root.can-download;
                    activated => { root.download-to(); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("New Folder…");
                    enabled: root.can-new-folder;
                    activated => { root.new-folder(); }
                }
                MenuItem {
                    title: @tr("Rename…");
                    enabled: root.can-write && root.context-row >= 0;
                    activated => { root.rename-start(); }
                }
                MenuItem {
                    title: @tr("Move To…");
                    enabled: root.can-write && root.context-row >= 0;
                    activated => { root.move-start(); }
                }
                MenuItem {
                    title: @tr("Delete…");
                    enabled: root.can-delete;
                    activated => { root.delete(); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Copy Public Link");
                    enabled: root.context-row >= 0;
                    activated => { root.copy-link(); }
                }
                MenuItem {
                    title: @tr("Copy Path");
                    enabled: root.context-row >= 0;
                    activated => { root.copy-path(); }
                }
                if root.presign-available: MenuItem {
                    title: @tr("Copy Presigned Link…");
                    enabled: root.context-row >= 0;
                    activated => { root.copy-presigned(); }
                }
                MenuItem {
                    title: @tr("Add to Favorites");
                    enabled: root.context-folder;
                    activated => { root.add-favorite(root.context-row); }
                }
                MenuItem {
                    title: @tr("Purge from CDN");
                    enabled: root.can-purge;
                    activated => { root.purge(); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Refresh");
                    activated => { root.refresh(); }
                }
            }
        }
        local-menu := ContextMenuArea {
            enabled: false;
            Menu {
                MenuItem {
                    title: @tr("Quick Look");
                    enabled: root.context-row >= 0;
                    activated => { root.quick-look(); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Upload");
                    enabled: root.can-upload;
                    activated => { root.upload(); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("New Folder…");
                    enabled: root.can-new-folder;
                    activated => { root.new-folder(); }
                }
                MenuItem {
                    title: @tr("Show in Explorer");
                    enabled: root.context-row >= 0;
                    activated => { root.show-in-explorer(root.context-row); }
                }
                MenuItem {
                    title: @tr("Add to Favorites");
                    enabled: root.context-folder;
                    activated => { root.add-favorite(root.context-row); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Refresh");
                    activated => { root.refresh(); }
                }
            }
        }

        // Every key that reaches the pane from one of its parts (a breadcrumb, a column header)
        // tells the window the pane holds the focus, so that Alt+Left and Alt+Right, which the
        // window handles, act on this pane. The list is the pane's own first child: it marks the
        // pane through `has-focus`. Not a Tab stop, and the keys go on to the window.
        inside-keys := FocusScope {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                root.key-inside();
                return reject;
            }

            VerticalLayout {
                // Header (mockup `.pane-head`).
                Rectangle {
                    height: 37px + Theme.grow;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 8px;

                        VCenter {
                            HorizontalLayout {
                                spacing: 8px;
                                Image {
                                    source: root.icon;
                                    colorize: Theme.label;
                                    width: 16px;
                                    height: 16px;
                                    accessible-role: none;
                                }
                                Text {
                                    text: root.title;
                                    color: Theme.label;
                                    font-size: Theme.font-body;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    accessible-role: none;
                                }
                            }
                        }
                        // Breadcrumbs (mockup `.crumbs`). Every crumb but the last is a button; the last
                        // is the current folder, in plain text. A path too long for the header shrinks
                        // the names with an ellipsis instead of overflowing it.
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            clip: true;

                            HorizontalLayout {
                                alignment: start;
                                spacing: 2px;

                                for crumb[i] in root.crumbs: HorizontalLayout {
                                    spacing: 2px;

                                    if i > 0: VCenter {
                                        Image {
                                            source: Icons.chev-r;
                                            colorize: Theme.label3;
                                            width: 12px;
                                            height: 12px;
                                            accessible-role: none;
                                        }
                                    }
                                    if i < root.crumbs.length - 1: Crumb {
                                        text: crumb;
                                        // A crumb holds the focus only when the keyboard put it there.
                                        clicked => { root.go-to-crumb(i, self.has-focus); }
                                    }
                                    if i == root.crumbs.length - 1: CurrentCrumb {
                                        text: crumb;
                                    }
                                }
                            }
                        }
                        if root.show-loading: VCenter {
                            LoadingMark { }
                        }
                        // Compare is on (mockup: This PC's header, in the accent colour).
                        if root.comparing && !root.cloud: VCenter {
                            Chip {
                                text: @tr("Comparing");
                                icon: Icons.compare;
                                fg: Theme.accent-text;
                                bg: Theme.accent-soft;
                            }
                        }
                        if root.header-chip != "": VCenter {
                            Rectangle {
                                height: Theme.chip-height;
                                background: Theme.chip;
                                border-radius: self.height / 2;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.header-chip;
                                        color: Theme.label2;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-small;
                                        font-weight: Theme.weight-semibold;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        // Lists the folder shown again (also F5 and Ctrl+R, and the menu's Refresh).
                        VCenter {
                            ToolButton {
                                icon: Icons.refresh;
                                label: @tr("Refresh");
                                description: root.can-refresh ? "" : @tr("No site selected");
                                enabled: root.can-refresh;
                                clicked => { root.refresh(); }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - self.height;
                        height: 1px;
                        background: Theme.sep;
                    }
                }

                // Column headers (mockup `.cols`); the grid has none (it keeps the list's order).
                if !root.grid: Rectangle {
                    height: 26px + Theme.grow-small;

                    HorizontalLayout {
                        padding-left: Cols.pad;
                        padding-right: Cols.pad;
                        spacing: Cols.gap;

                        ColumnHeader {
                            horizontal-stretch: 1;
                            text: @tr("Name");
                            sorted: root.sort-column == 0;
                            ascending: root.sort-ascending;
                            clicked => { root.sort-by(0); }
                        }
                        // Not a sort key: the rows keep the order of the column sorted.
                        if root.comparing: Rectangle {
                            width: root.col-status-width;

                            Text {
                                x: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("Status");
                                color: Theme.label2;
                                font-size: Theme.font-small;
                                font-weight: Theme.weight-semibold;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            ColumnHandle {
                                x: -(Cols.gap + Cols.handle) / 2;
                                height: parent.height;
                                start-width: parent.width;
                                resized(width) => {
                                    root.col-status-width = width;
                                    root.columns-resized();
                                }
                                reset => {
                                    root.col-status-width = Cols.status;
                                    root.columns-resized();
                                }
                            }
                        }
                        ColumnHeader {
                            width: root.col-size-width;
                            text: @tr("Size");
                            right-aligned: true;
                            resizable: true;
                            sorted: root.sort-column == 1;
                            ascending: root.sort-ascending;
                            clicked => { root.sort-by(1); }
                            resized(width) => {
                                root.col-size-width = width;
                                root.columns-resized();
                            }
                            reset => {
                                root.col-size-width = Cols.size;
                                root.columns-resized();
                            }
                        }
                        ColumnHeader {
                            width: root.col-modified-width;
                            text: @tr("Modified");
                            resizable: true;
                            sorted: root.sort-column == 2;
                            ascending: root.sort-ascending;
                            clicked => { root.sort-by(2); }
                            resized(width) => {
                                root.col-modified-width = width;
                                root.columns-resized();
                            }
                            reset => {
                                root.col-modified-width = Cols.modified;
                                root.columns-resized();
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - self.height;
                        height: 1px;
                        background: Theme.sep;
                    }
                }

                // The list view insets its content by 2 px on every side; the list reaches out by that
                // much so that the rows, and the selection, run edge to edge as in the mockup.
                list-area := Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    list := ListView {
                        x: -2px;
                        y: -2px;
                        width: parent.width + 4px;
                        height: parent.height + 4px;
                        visible: !root.grid;
                        accessible-label: @tr("Files in {}", root.title);
                        accessible-item-count: root.rows.length;

                        for item[i] in root.rows: PaneRow {
                            item: item;
                            index: i;
                            count: root.rows.length;
                            selected: item.selected;
                            drop-target: root.drop-hover && i == root.drop-row;
                            drag-ok: root.can-drag;
                            comparing: root.comparing;
                            remote-label: root.compare.remote-label;
                            status-width: root.col-status-width;
                            size-width: root.col-size-width;
                            modified-width: root.col-modified-width;
                            pressed(ctrl, shift) => { root.pick(i, ctrl, shift); }
                            held => {
                                // The selection stays until the button comes up (it may be a drag),
                                // but the pane takes the focus now.
                                root.keyboard-focus = false;
                                key-focus.focus();
                            }
                            drag-moved(point) => { root.drag-moved(point); }
                            drag-ended(point) => { root.drag-ended(point); }
                            drag-cancelled => { root.drag-cancelled(); }
                            context-pressed(point) => { root.row-menu(i, point); }
                            opened => {
                                root.pick(i, false, false);
                                root.open(i);
                            }
                        }
                    }

                    // The grid: one line of tiles per item of the list view, so that only the
                    // lines in view are made.
                    grid-list := ListView {
                        x: -2px;
                        y: -2px;
                        width: parent.width + 4px;
                        height: parent.height + 4px;
                        visible: root.grid;
                        accessible-label: @tr("Files in {}", root.title);
                        accessible-item-count: root.rows.length;

                        for line in root.grid ? root.grid-lines : 0: Rectangle {
                            height: Grid.tile-h;

                            for column in Math.min(root.grid-cols, root.rows.length - line * root.grid-cols): PaneTile {
                                property <int> at: line * root.grid-cols + column;

                                // The lines are centred in the pane.
                                x: Math.max(Grid.pad, (parent.width - root.grid-cols * Grid.tile-w) / 2) + column * Grid.tile-w;
                                y: 0px;
                                item: root.rows[self.at];
                                index: self.at;
                                count: root.rows.length;
                                drop-target: root.drop-hover && self.at == root.drop-row;
                                drag-ok: root.can-drag;
                                pressed(ctrl, shift) => { root.pick(self.at, ctrl, shift); }
                                held => {
                                    root.keyboard-focus = false;
                                    key-focus.focus();
                                }
                                drag-moved(point) => { root.drag-moved(point); }
                                drag-ended(point) => { root.drag-ended(point); }
                                drag-cancelled => { root.drag-cancelled(); }
                                context-pressed(point) => { root.row-menu(self.at, point); }
                                opened => {
                                    root.pick(self.at, false, false);
                                    root.open(self.at);
                                }
                            }
                        }
                    }

                    // The empty space below the last row. Pressing there clears the selection (Ctrl
                    // keeps it) and dragging draws the rubber band, which selects the rows it crosses.
                    // A full list has no empty space, so no band.
                    band-area := TouchArea {
                        property <bool> banding: false;
                        property <bool> additive: false;
                        // The corner the drag started at and the pointer, in the list's coordinates.
                        property <length> start-x;
                        property <length> start-y;
                        property <length> now-x;
                        property <length> now-y;

                        x: 0px;
                        // In the grid: below its last line, where a press only clears the
                        // selection (no band: tiles are not rows).
                        y: root.grid ? Math.max(0px, root.grid-lines * Grid.tile-h + grid-list.content-y) : Math.max(0px, root.rows.length * Theme.row-height + list.content-y);
                        width: parent.width;
                        height: Math.max(0px, parent.height - self.y);

                        // The band over the rows: its first and last row, or -1 and -1 when it
                        // crosses none.
                        function report() {
                            let top = Math.max(0px, Math.min(self.start-y, self.now-y));
                            let bottom = Math.min(parent.height, Math.max(self.start-y, self.now-y));
                            let first = Math.floor((top - list.content-y) / Theme.row-height);
                            let last = Math.floor((bottom - list.content-y) / Theme.row-height);
                            if (last < 0 || first >= root.rows.length) {
                                root.band-select(-1, -1, self.additive);
                            } else {
                                root.band-select(Math.max(0, first), Math.min(root.rows.length - 1, last), self.additive);
                            }
                        }

                        pointer-event(event) => {
                            if (root.grid && event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.keyboard-focus = false;
                                key-focus.focus();
                                root.band-select(-1, -1, event.modifiers.control);
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                self.banding = true;
                                self.additive = event.modifiers.control;
                                self.start-x = self.x + self.mouse-x;
                                self.start-y = self.y + self.mouse-y;
                                self.now-x = self.start-x;
                                self.now-y = self.start-y;
                                root.keyboard-focus = false;
                                key-focus.focus();
                                self.report();
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                self.banding = false;
                            }
                        }
                        moved => {
                            if (self.banding) {
                                self.now-x = Math.max(0px, Math.min(parent.width, self.x + self.mouse-x));
                                self.now-y = Math.max(0px, Math.min(parent.height, self.y + self.mouse-y));
                                self.report();
                            }
                        }
                    }

                    if band-area.banding: Rectangle {
                        x: Math.min(band-area.start-x, band-area.now-x);
                        y: Math.min(band-area.start-y, band-area.now-y);
                        width: Math.abs(band-area.now-x - band-area.start-x);
                        height: Math.abs(band-area.now-y - band-area.start-y);
                        background: Theme.accent.with-alpha(0.2);
                        border-width: 1px;
                        border-color: Theme.accent;
                    }
                }
            }
        }

        // Files are over the pane: a light accent wash, the accent ring and a chip that says what
        // letting go does. Over a folder row the wash goes (the row is outlined instead) and the
        // chip moves to the bottom, out of the row's way. Inside the card so that its rounded clip
        // does not cut the ring.
        if root.drop-hover: Rectangle {
            background: root.drop-row >= 0 ? transparent : Theme.accent-soft;
            border-radius: card.border-radius;
            border-width: 2px;
            border-color: Theme.accent;

            VerticalLayout {
                alignment: root.drop-row >= 0 ? end : center;
                padding-bottom: root.drop-row >= 0 ? 12px : 0px;
                padding-left: 12px;
                padding-right: 12px;

                HorizontalLayout {
                    alignment: center;

                    DropChip {
                        text: root.cloud ? (root.drop-row >= 0 ? @tr("Release to upload to {}", root.rows[root.drop-row].name) : @tr("Release to upload")) : (root.drop-row >= 0 ? @tr("Release to download to {}", root.rows[root.drop-row].name) : @tr("Release to download"));
                        icon: root.cloud ? Icons.up : Icons.down;
                    }
                }
            }
        }

        // Keyboard focus ring, inside the card so that its rounded clip does not cut it.
        Rectangle {
            border-radius: card.border-radius;
            border-width: 2px;
            border-color: Theme.focus-ring;
            visible: root.focus-visible;
        }
    }
}
