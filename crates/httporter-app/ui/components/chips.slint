// Small tinted capsules and marks: chips, the connection pill, status dots and provider tiles.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { CompareStatus } from "../types.slint";
import { VCenter } from "layout.slint";

// Tinted label capsule (mockup `.chip`). Defaults to the neutral grey chip.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> fg: Theme.label2;
    in property <color> bg: Theme.chip;

    height: Theme.chip-height;
    background: root.bg;
    border-radius: self.height / 2;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;

        if root.icon.width > 0: VCenter {
            Image {
                source: root.icon;
                colorize: root.fg;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

// How a row compares with the other side while Compare is on (mockup `.chip.changed`, `.chip.new`,
// `.chip.remote`, `.chip.same`): Changed in orange, New in green, "Only on Bunny" in purple, Same as
// plain grey text. On a selected row (`lit`) the words turn white over a light wash (mockup
// `.row.sel .chip`). Nothing shows for `none`. The row gives the words (`text`), which it also reads
// out.
//
// I7: when the row's status changes in place (a publish turns "Changed" and "New" into "Same"), the
// colours fade to the new ones over `Theme.motion-control`. `key` names the row (its file name):
// a list that hands the chip to another row as it scrolls changes the key too, and that snaps.
export component StatusChip inherits Rectangle {
    in property <CompareStatus> status;
    in property <string> text;
    in property <bool> lit: false;
    in property <string> key;

    property <bool> plain: root.status == CompareStatus.same;
    property <color> tint: root.status == CompareStatus.changed ? Theme.orange : root.status == CompareStatus.new ? Theme.green : root.status == CompareStatus.remote-only ? Theme.purple : Theme.label2;
    property <color> wash: root.status == CompareStatus.changed ? Theme.orange-soft : root.status == CompareStatus.new ? Theme.green-soft : Theme.purple-soft;
    // The colours wanted now, and those drawn (which follow them, fading or not; see `paint`).
    property <color> want-bg: root.plain ? transparent : (root.lit ? #ffffff38 : root.wash);
    property <color> want-ink: root.lit ? Theme.sel-text : root.tint;
    property <color> bg: root.want-bg;
    property <color> ink: root.want-ink;
    // What was painted last: the row, the status and the two colours aimed at.
    property <string> painted-key;
    property <CompareStatus> painted-status;
    property <color> aimed-bg: root.want-bg;
    property <color> aimed-ink: root.want-ink;
    property <bool> fading: false;

    animate bg, ink {
        duration: root.fading ? Theme.motion-control : 0ms;
        easing: ease-in-out;
    }

    // Fades only when the same row's status changed; a new row, the selection or the theme snap.
    // Several handlers may call it for one change: only the first one aims anew.
    function paint() {
        root.fading = root.key == root.painted-key && root.status != root.painted-status;
        root.painted-key = root.key;
        root.painted-status = root.status;
        if (root.want-bg != root.aimed-bg) {
            root.aimed-bg = root.want-bg;
            root.bg = root.want-bg;
        }
        if (root.want-ink != root.aimed-ink) {
            root.aimed-ink = root.want-ink;
            root.ink = root.want-ink;
        }
    }

    init => {
        root.painted-key = root.key;
        root.painted-status = root.status;
        root.aimed-bg = root.want-bg;
        root.aimed-ink = root.want-ink;
        // From here on only `paint` sets them.
        root.bg = root.want-bg;
        root.ink = root.want-ink;
    }
    changed want-bg => { root.paint(); }
    changed want-ink => { root.paint(); }
    changed key => { root.paint(); }

    height: Theme.chip-height;
    visible: root.status != CompareStatus.none;
    background: root.bg;
    border-radius: self.height / 2;
    accessible-role: none;

    HorizontalLayout {
        padding-left: root.plain ? 0px : 8px;
        padding-right: root.plain ? 0px : 8px;

        Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.font-small;
            font-weight: root.plain ? Theme.weight-medium : Theme.weight-semibold;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

// Connection state in the toolbar (mockup `.conn`): green with a lock when connected, orange with a
// warning otherwise. While `connecting` a dot stands in for the lock and pulses (I7); its timer
// runs only then.
export component ConnectionPill inherits Rectangle {
    in property <string> text;
    in property <bool> ok: true;
    in property <bool> connecting: false;

    property <color> fg: root.ok ? Theme.green : Theme.orange;
    // The dot is dim, then bright, each half of the pulse.
    property <bool> dim: false;

    height: Theme.chip-height + 4px;
    background: root.ok ? Theme.green-soft : Theme.orange-soft;
    border-radius: self.height / 2;

    Timer {
        interval: 600ms;
        running: root.connecting && Theme.motion;
        triggered => { root.dim = !root.dim; }
    }
    changed connecting => { root.dim = false; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;

        if !root.connecting: VCenter {
            Image {
                source: root.ok ? Icons.lock : Icons.warn;
                colorize: root.fg;
                width: 14px;
                height: 14px;
            }
        }
        if root.connecting: VCenter {
            HorizontalLayout {
                width: 14px;
                alignment: center;

                VCenter {
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: self.height / 2;
                        background: root.fg;
                        opacity: root.dim ? 0.3 : 1;

                        animate opacity { duration: Theme.motion-panel * 2; easing: ease-in-out; }
                    }
                }
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

// 7 px status dot (mockup `.dot`).
export component StatusDot inherits Rectangle {
    in property <color> tint: Theme.green;

    width: 7px;
    height: 7px;
    border-radius: self.height / 2;
    background: root.tint;
}

// A site's health in the sidebar (ledger 130): the green dot while its last request worked, and
// an orange warning triangle once one failed, so that the shape says it as well as the colour.
// The row's label says it in words; the mark itself is not read out.
export component HealthMark inherits Rectangle {
    in property <bool> ok: true;

    width: 12px;
    height: 12px;
    accessible-role: none;

    if root.ok: StatusDot {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: Theme.green;
    }
    if !root.ok: Image {
        width: 12px;
        height: 12px;
        source: Icons.warn;
        colorize: Theme.orange;
        accessible-role: none;
    }
}

// 18 px provider tile with one or two letters (mockup `.monotile`), filled with the provider's colour.
// The tile grows with Windows' text size, as its letters do. The letters are white, at least
// 4.8:1 on every provider's colour (ledger 128). The name beside the tile says the same, so the
// tile is not read out.
export component MonoTile inherits Rectangle {
    in property <string> mono;
    in property <color> tint: Theme.accent;

    width: Theme.tile-size;
    height: Theme.tile-size;
    border-radius: 5px;
    background: root.tint;
    accessible-role: none;

    Text {
        text: root.mono;
        color: Theme.tile-text;
        font-size: Theme.font-tile;
        font-weight: Theme.weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
