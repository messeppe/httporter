// Rename, Move To…, the warning before a move that downloads and uploads again (it also asks
// before a big file is fetched for a preview), and the pre-signed link sheet.
//
// Rename, Move To… and the presign sheet hang from the toolbar like New Folder; the app checks
// what was typed and either shows `error` or closes the sheet. The warning is an alert whose
// confirm closes it (app.slint). Escape cancels each.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { MoveData, MoveWarningData, PresignData, RenameData } from "../types.slint";
import { CapsuleButton } from "buttons.slint";
import { ErrorLine, Field, FormRow, RadioList } from "form_controls.slint";
import { AlertCard, AttachedSheet, Modal } from "sheets.slint";

// The title line of a sheet.
component SheetTitle inherits HorizontalLayout {
    in property <string> text;

    padding-left: 22px;
    padding-right: 22px;
    padding-top: 20px;

    Text {
        text: root.text;
        color: Theme.label;
        font-size: Theme.font-headline;
        font-weight: Theme.weight-semibold;
        overflow: elide;
        accessible-role: none;
    }
}

// The line between a sheet's fields and its buttons.
component FootRule inherits Rectangle {
    height: 1px;
    background: Theme.sep;
}

// F2: the new name ("/" refused). The app closes it.
export component RenameSheet inherits Rectangle {
    in property <RenameData> data;
    callback confirm(string);
    callback cancelled();

    function submit() {
        if (!root.data.busy) {
            root.confirm(name-field.text);
        }
    }

    init => {
        name-field.text = root.data.name;
        name-field.focus();
        name-field.select-all();
    }

    modal := Modal {
        at-first-stop: name-field.has-focus;
        at-last-stop: rename-button.has-focus;
        cancel => { self.leave(0); }
        left => { root.cancelled(); }
        confirm => { root.submit(); }
        focus-first => { name-field.focus(); }
        focus-last => { rename-button.focus(); }

        AttachedSheet {
            sheet-width: 440px;
            label: root.data.title;

            SheetTitle { text: root.data.title; }
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 16px;
                padding-bottom: 14px;
                spacing: 6px;

                FormRow {
                    label: @tr("Name");

                    name-field := Field {
                        label: @tr("New name");
                        error: root.data.error;
                        enabled: !root.data.busy;
                        accepted => { root.submit(); }
                    }
                    if root.data.error != "": ErrorLine { text: root.data.error; }
                    if root.data.note != "": Text {
                        text: root.data.note;
                        color: Theme.label2;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }
            FootRule { }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 8px;
                alignment: end;

                CapsuleButton {
                    text: @tr("Cancel");
                    clicked => { modal.leave(0); }
                }
                rename-button := CapsuleButton {
                    text: root.data.busy ? @tr("Renaming…") : @tr("Rename");
                    primary: true;
                    enabled: !root.data.busy;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}

// Move To…: the destination folder (the current one to start with). The app closes it.
export component MoveSheet inherits Rectangle {
    in property <MoveData> data;
    callback confirm(string);
    callback cancelled();

    function submit() {
        if (!root.data.busy) {
            root.confirm(folder-field.text);
        }
    }

    init => {
        folder-field.text = root.data.destination;
        folder-field.focus();
        folder-field.select-all();
    }

    modal := Modal {
        at-first-stop: folder-field.has-focus;
        at-last-stop: move-button.has-focus;
        cancel => { self.leave(0); }
        left => { root.cancelled(); }
        confirm => { root.submit(); }
        focus-first => { folder-field.focus(); }
        focus-last => { move-button.focus(); }

        AttachedSheet {
            sheet-width: 480px;
            label: root.data.title;

            SheetTitle { text: root.data.title; }
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 16px;
                padding-bottom: 14px;
                spacing: 6px;

                FormRow {
                    label: @tr("To folder");

                    folder-field := Field {
                        label: @tr("Destination folder");
                        placeholder: @tr("/ for the top of the site");
                        error: root.data.error;
                        enabled: !root.data.busy;
                        accepted => { root.submit(); }
                    }
                    if root.data.error != "": ErrorLine { text: root.data.error; }
                    if root.data.note != "": Text {
                        text: root.data.note;
                        color: Theme.label2;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }
            FootRule { }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 8px;
                alignment: end;

                CapsuleButton {
                    text: @tr("Cancel");
                    clicked => { modal.leave(0); }
                }
                move-button := CapsuleButton {
                    text: root.data.busy ? @tr("Checking…") : @tr("Move");
                    primary: true;
                    enabled: !root.data.busy;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}

// A warning that asks before going on: a move that downloads, uploads and then deletes (Bunny
// can't copy on the server), or a big file fetched for a preview. Cancel is the default.
export component MoveWarningSheet inherits Rectangle {
    in property <MoveWarningData> data;
    callback confirm();
    callback cancelled();

    init => { cancel-button.focus(); }

    modal := Modal {
        at-first-stop: go-button.has-focus;
        at-last-stop: cancel-button.has-focus;
        cancel => { self.leave(0); }
        left(how) => {
            if (how == 1) {
                root.confirm();
            } else {
                root.cancelled();
            }
        }
        confirm => { self.leave(0); }
        focus-first => { go-button.focus(); }
        focus-last => { cancel-button.focus(); }

        AlertCard {
            icon: Icons.warn;
            tint: Theme.orange;
            tint-soft: Theme.orange-soft;
            title: root.data.title;
            body: root.data.body;

            HorizontalLayout {
                spacing: 8px;

                go-button := CapsuleButton {
                    horizontal-stretch: 1;
                    text: root.data.button;
                    clicked => { modal.leave(1); }
                }
                cancel-button := CapsuleButton {
                    horizontal-stretch: 1;
                    text: @tr("Cancel");
                    primary: true;
                    clicked => { modal.leave(0); }
                }
            }
        }
    }
}

// Copy Presigned Link…: how long the link lasts (`PresignData.expiry`). The app closes it.
export component PresignSheet inherits Rectangle {
    in property <PresignData> data;
    // The expiry chosen.
    callback copy(int);
    callback cancelled();

    init => {
        expiry-list.current = root.data.expiry;
        expiry-list.focus();
    }

    modal := Modal {
        at-first-stop: expiry-list.has-focus;
        at-last-stop: copy-button.has-focus;
        cancel => { self.leave(0); }
        left => { root.cancelled(); }
        confirm => { root.copy(expiry-list.current); }
        focus-first => { expiry-list.focus(); }
        focus-last => { copy-button.focus(); }

        AttachedSheet {
            sheet-width: 420px;
            label: root.data.title;

            SheetTitle { text: root.data.title; }
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 16px;
                padding-bottom: 14px;
                spacing: 8px;

                FormRow {
                    label: @tr("Link lasts");

                    expiry-list := RadioList {
                        label: @tr("How long the link lasts");
                        options: [@tr("15 minutes"), @tr("1 hour"), @tr("1 day"), @tr("7 days")];
                    }
                }
                Text {
                    text: @tr("Anyone with the link can download the file until it expires.");
                    color: Theme.label2;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                if root.data.error != "": ErrorLine { text: root.data.error; }
            }
            FootRule { }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 8px;
                alignment: end;

                CapsuleButton {
                    text: @tr("Cancel");
                    clicked => { modal.leave(0); }
                }
                copy-button := CapsuleButton {
                    text: @tr("Copy Link");
                    primary: true;
                    clicked => { root.copy(expiry-list.current); }
                }
            }
        }
    }
}
