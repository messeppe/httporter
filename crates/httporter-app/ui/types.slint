// Data shapes shared by the window, its components and (via app.slint) the Rust side.

export enum FileKind { folder, code, image, doc }

export struct FileRow {
    name: string,
    kind: FileKind,
    size: string,
    modified: string,
    folder: bool,
}

// The provider tile a site shows (mockup `providers`): Bunny, or an S3 service by preset. The
// tile's colour comes from this, never from the site's name or its letters.
export enum ProviderTile { bunny, s3, r2, b2, wasabi, digital-ocean, minio, other }

export struct SiteItem {
    id: string,
    name: string,
    subtitle: string,
    provider: ProviderTile,
    mono: string,
    healthy: bool,
}

// One row of the transfer drawer. `id` is the job's id in the engine (what the row's buttons hand
// back), `percent` runs 0 to 100, and `detail` is the Failed tab's reason or a queued row's
// "Paused". `paused` is a queued job paused on its own: its menu then offers Resume.
export struct TransferRow {
    id: int,
    name: string,
    kind: FileKind,
    size: string,
    percent: float,
    detail: string,
    paused: bool,
}
