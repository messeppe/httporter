// Data shapes shared by the window, its components and (via app.slint) the Rust side.

export enum FileKind { folder, code, image, doc }

// How a row compares with the other pane's folder while Compare is on; `none` while it is off or
// the row is outside the compared folders.
export enum CompareStatus { none, changed, new, remote-only, same }

export struct FileRow {
    name: string,
    kind: FileKind,
    size: string,
    modified: string,
    folder: bool,
    // In the pane's selection: the row is drawn highlighted. The app keeps it up to date.
    selected: bool,
    status: CompareStatus,
}

// The provider tile a site shows (mockup `providers`): Bunny, or an S3 service by preset. The
// tile's colour comes from this, never from the site's name or its letters.
export enum ProviderTile { bunny, s3, r2, b2, wasabi, digital-ocean, minio, other }

export struct SiteItem {
    id: string,
    name: string,
    subtitle: string,
    provider: ProviderTile,
    mono: string,
    healthy: bool,
}

// One row of the transfer drawer. `id` is the job's id in the engine (what the row's buttons hand
// back), `percent` runs 0 to 100, and `detail` is the Failed tab's reason or a queued row's
// "Paused". `paused` is a queued job paused on its own: its menu then offers Resume.
export struct TransferRow {
    id: int,
    name: string,
    kind: FileKind,
    size: string,
    percent: float,
    detail: string,
    paused: bool,
}

// Whether the two files of a conflict hold the same contents (the conflict sheet's Contents column);
// `unknown` when neither side had a digest to tell by.
export enum ConflictContents { identical, different, unknown }

// One row of the conflict sheet. `source` and `target` are the sides as "357.2 KB · Today 09:58":
// the side the files come from and the side they go to. `contents` is the word for `same`, and
// `action` is the row's choice: 0 Replace, 1 Skip, 2 Keep both.
export struct ConflictRow {
    name: string,
    kind: FileKind,
    source: string,
    target: string,
    contents: string,
    same: ConflictContents,
    action: int,
}

// Where a pane is in the window, in logical pixels, for telling what a point is over (a dragged
// file's position, see src/drop_hook.rs). `list-top` is the top edge of the list, where its first
// row starts when it is not scrolled; `scroll-y` is how far it is scrolled down (0 or more).
export struct PaneBounds {
    x: length,
    y: length,
    width: length,
    height: length,
    list-top: length,
    row-height: length,
    scroll-y: length,
    rows: int,
}

// One storage zone in the list the Add Site sheet shows after Find Zones (Bunny account key). The
// sheet writes "{name} · {region} · {hostnames}" for a zone that can be added and greys out the
// others with their `reason`. Which zones are ticked lives apart from the zones, in the sheet's
// `[bool]` of the same length.
export struct ZoneChoice {
    name: string,
    // The city of the zone's region, for example "Singapore".
    region: string,
    // The hostnames of the pull zones in front of it, joined with ", "; empty for none.
    hostnames: string,
    // False for a zone the account has but that can't be added.
    usable: bool,
    reason: string,
}

// The fields of the Add Site sheet that are not secret. The app hands one to the sheet to start
// from (editing or duplicating a site, `provider` being the tile of the provider grid: 0 Bunny,
// then the S3 services in the order of the grid), and the sheet reports one back with the
// secret in a separate string, so that no secret is ever kept in a struct that is passed around.
export struct SiteDraft {
    provider: int,
    name: string,
    zone: string,
    // Position in the Bunny region list.
    region-index: int,
    // The S3 region as typed.
    region: string,
    account-id: string,
    endpoint: string,
    path-style: bool,
    bucket: string,
    key-id: string,
}

// The messages under the S3 fields of the Add Site sheet; an empty one shows nothing.
export struct S3Errors {
    region: string,
    account-id: string,
    endpoint: string,
    bucket: string,
    key-id: string,
    secret: string,
}

// ---- Publish (I3) ----

// What Compare found, for the status bar and the panes. `remote-label` names the site's side in
// "Only on Bunny" / "Only on {site}"; `progress` is shown while `busy`; `error` when it failed.
export struct CompareSummary {
    active: bool,
    busy: bool,
    progress: string,
    changed: int,
    new: int,
    remote-only: int,
    remote-label: string,
    error: string,
}

// A publish profile in the sidebar: its name and `meta` ("2h ago", "Never").
export struct ProfileItem {
    id: string,
    name: string,
    meta: string,
}

// The groups of the Publish sheet's plan list.
export enum PlanGroup { changed, new, kept, deleted }

// One row of the plan list: a group header (`header`) or a file. `label` is what happens to it
// ("Will be kept", "Will be deleted").
export struct PlanRow {
    path: string,
    kind: FileKind,
    group: PlanGroup,
    label: string,
    size: string,
    checked: bool,
    header: bool,
}

// Everything the Publish sheet shows apart from the plan list. `purge`: 0 off, 1 changed files,
// 2 whole zone. `needs-review`: the delete guard tripped, so the button opens Review Deletions,
// where typing `review-name` (the zone or bucket) lets the publish go ahead.
export struct PublishSheetData {
    title: string,
    subtitle: string,
    folder: string,
    destination: string,
    destination-note: string,
    busy: bool,
    progress: string,
    error: string,
    changed: int,
    new: int,
    remote-only: int,
    same: int,
    upload-text: string,
    remove-extras: bool,
    remove-label: string,
    purge: int,
    purge-enabled: bool,
    purge-note: string,
    warning: string,
    button-label: string,
    can-publish: bool,
    needs-review: bool,
    review-name: string,
}

// One publish in the profile page's history table.
export struct HistoryRow {
    id: int,
    when: string,
    result: string,
    failed: bool,
    uploaded: string,
    deleted: string,
    size: string,
    time: string,
    purge: string,
}

// The failed detail under the history table, for publish `id`.
export struct HistoryDetail {
    id: int,
    summary: string,
    paths: [string],
    total: int,
    failed: int,
    purge-failed: bool,
    all-shown: bool,
}

// The profile page's header, chips and cards.
export struct ProfileView {
    id: string,
    name: string,
    folder: string,
    destination: string,
    chips: [string],
    last-title: string,
    last-detail: string,
    remote-title: string,
    remote-label: string,
    remote-detail: string,
    schedule: string,
    footer: string,
    status: string,
}

// The fields of the profile sheet (new and edit; `id` empty for a new profile). `purge` as in
// PublishSheetData; the numbers as typed.
export struct ProfileDraft {
    id: string,
    name: string,
    site-name: string,
    folder: string,
    remote-dir: string,
    skip-rules: string,
    remove-extras: bool,
    purge: int,
    guard-files: string,
    guard-percent: string,
    cdn-note: string,
    error: string,
}
